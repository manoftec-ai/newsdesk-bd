# Jev (TypeSafe AI) — local environment template. COPY, do not use in place.
#
#   cp pipeline/config/jev.env.example ~/.config/opencode/.secrets/typesafe.env
#   chmod 600 ~/.config/opencode/.secrets/typesafe.env
#   set -a; . ~/.config/opencode/.secrets/typesafe.env; set +a
#
# Get a key at https://console.typesafe.ai/keys (early access).
# NEVER paste the key into chat, into this repo, or into a GitHub/Vercel config
# for the shadow-mode setup — it is a LOCAL developer credential only.

# Option A — direct env var (fine for a throwaway shell).
TYPESAFE_API_KEY=

# Option B — preferred: keep the key in its own file so it never enters shell
# history. Point the router at it instead of using Option A.
#   node tools/jev_decide.mjs AGENT_ROUTE --state-file=state.json
# TYPESAFE_API_KEY_FILE=/data/data/com.termux/files/home/.config/opencode/.secrets/typesafe.key

# shadow  = decisions are logged, never enforced (the only allowed mode today)
# disabled= no HTTP call is attempted at all
JEV_MODE=shadow

# Where the redacted JSONL shadow log is written. Default: pipeline/logs/
# (already excluded by .gitignore). Keep it out of git.
JEV_SHADOW_LOG_DIR=/data/data/com.termux/files/home/project-coba/newsdesk-bd/pipeline/logs
