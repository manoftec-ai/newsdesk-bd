{
  "name": "jachaidesk-site",
  "version": "0.1.0",
  "description": "যাচাইডেস্ক — automated verified Bengali news desk (Astro static site).",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/search-index.mjs",
    "preview": "astro preview",
    "format": "prettier --write .",
    "deploy": "./deploy.sh",
    "deploy:token": "vercel deploy --prod --yes --token \"$VERCEL_TOKEN\""
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "astro": "^7.0.4",
    "tailwindcss": "^4.3.1"
  },
  "devDependencies": {
    "pagefind": "^1.3.0",
    "prettier": "^3.8.4",
    "vite": "^8.1.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
