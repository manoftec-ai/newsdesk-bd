---
import "../styles.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE, SEO, imageSrc } from "../lib/news-data.js";

const {
  title = `${SITE.name} — ${SITE.tagline}`,
  description = SITE.description,
  canonical,
  robots,
  ogType = "website",
  ogImage,
  ogImageWidth = 1200,
  ogImageHeight = 630,
  article,
  jsonLd,
  flushFooter = false,
  language = SITE.language,
} = Astro.props;

const siteUrl = Astro.site?.toString() || SITE.url;
const absoluteUrl = (value) => {
  const src = imageSrc(value) || value;
  if (!src) return undefined;

  try {
    return new URL(src, siteUrl).toString();
  } catch {
    return src;
  }
};
const canonicalUrl = absoluteUrl(canonical || Astro.url.pathname);
// SEO audit 2026-09-27 (+fix 2026-09-28: v1's Latin URL line rendered as tofu
// boxes on the GH runner — v2 drops it, brand + tagline only). Crawlers cannot
// render the old SVG fallback, so hub pages fell back to a broken social image.
// 2026-10-02: the OG card is now the supplied logo artwork. og-default-v2.png is
// kept in place so this is one line to revert, but note the logo is LIGHT
// wordmark on a DARK ground, so the card had to be composed on the brand dark
// (#2b231c, matching public/favicon.svg). Dropped onto the old light cream card
// the wordmark would have been invisible.
const ogImageUrl = absoluteUrl(ogImage || "/images/og-jachaidesk-logo.png");
---

<!doctype html>
<html lang={language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#b3352b" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta name="author" content={SITE.name} />
    {SEO.googleSiteVerification && (
      <meta name="google-site-verification" content={SEO.googleSiteVerification} />
    )}
    {SEO.bingSiteVerification && (
      <meta name="msvalidate.01" content={SEO.bingSiteVerification} />
    )}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="bn_BD" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content={String(ogImageWidth)} />}
    {ogImageUrl && <meta property="og:image:height" content={String(ogImageHeight)} />}
    {ogImageUrl && (
        <meta
          property="og:image:type"
          // Was: .png ? image/png : image/webp — which mislabelled every JPEG as
          // image/webp. A wrong MIME type makes some scrapers reject the card.
          content={
            ogImageUrl.endsWith(".png")
              ? "image/png"
              : ogImageUrl.endsWith(".webp")
                ? "image/webp"
                : "image/jpeg"
          }
        />
      )}
    {ogType === "article" && article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {ogType === "article" && article?.modifiedTime && (
      <meta property="article:modified_time" content={article.modifiedTime} />
    )}
    {ogType === "article" && article?.section && (
      <meta property="article:section" content={article.section} />
    )}
    {ogType === "article" &&
      (article?.tags ?? []).map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="manifest" href="/manifest.json" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <!-- FONT GUARD: keep only 2 faces (serif 700 + Hind 400), font-display optional, never add 500/600 — LCP guard P1-9 -->
    <link
      rel="preload"
      href="/fonts/noto-serif-bengali-bengali-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/hind-siliguri-bengali-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {
      jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
      )
    }
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem("theme");
          var dark = theme
            ? theme === "dark"
            : matchMedia("(prefers-color-scheme: dark)").matches;
          if (dark) document.documentElement.classList.add("dark");
        } catch (error) {}
      })();
    </script>
    <script defer src="/_vercel/insights/script.js"></script>
    <script is:inline>
      if ("serviceWorker" in navigator) {
        window.addEventListener("load", function () {
          navigator.serviceWorker.register("/sw.js").catch(function () {});
        });
      }
    </script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">প্রধান অংশে যান</a>
    <div class="flex min-h-dvh flex-col">
      <Header />
      <main id="main-content" class="flex-1" data-pagefind-body>
        <slot />
      </main>
      <Footer flush={flushFooter} />
    </div>
  </body>
</html>