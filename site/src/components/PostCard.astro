---
import { getCategory, getBadge, getAuthor, formatDateTimeBDShort } from "../lib/news-data.js";
import VerificationBadge from "./VerificationBadge.astro";

const { post, variant = "default", hidden = false } = Astro.props;
const category = getCategory(post.category);
const badge = getBadge(post);
const author = getAuthor(post.author);
const href = `/article/${post.slug}`;
---

{
  variant === "compact" ? (
    <a href={href} class="group block" hidden={hidden}>
      <div class="flex flex-wrap items-center gap-2">
        {category && (
          <span class="category-pill" style={`background-color:${category.color}`}>
            {category.name}
          </span>
        )}
        <VerificationBadge badge={badge} compact />
        {post.verification?.evidence?.length > 0 && (
          <span class="text-xs text-muted-foreground">· {post.verification.evidence.length} প্রমাণ</span>
        )}
        {author && (
          <span class="text-xs text-muted-foreground flex items-center gap-1">
            <span aria-hidden="true">✍️</span>
            {author.shortName || author.name}
          </span>
        )}
      </div>
      <h3 class="mt-1.5 font-serif text-lg font-semibold leading-snug text-foreground group-hover:text-primary">
        {post.title}
      </h3>
      <div class="mt-1 text-xs text-muted-foreground">
        <time datetime={new Date(post.ts).toISOString()}>{formatDateTimeBDShort(post.ts)}</time>
      </div>
    </a>
  ) : variant === "list" ? (
    <article class="group grid gap-6 border-b border-border/60 py-8 sm:grid-cols-[1fr_220px]" hidden={hidden}>
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
          {category && (
            <a href={`/category/${category.slug}`}>
              <span class="category-pill" style={`background-color:${category.color}`}>
                {category.name}
              </span>
            </a>
          )}
          <VerificationBadge badge={badge} compact />
          {post.verification?.evidence?.length > 0 && (
            <span>· {post.verification.evidence.length} প্রমাণ</span>
          )}
          {post.demo && <span class="rounded border border-border px-1.5 py-0.5">ডেমো</span>}
          <time datetime={new Date(post.ts).toISOString()}>{formatDateTimeBDShort(post.ts)}</time>
        </div>
        <a href={href} class="mt-1 block py-1">
          <h2 class="font-serif text-2xl font-semibold leading-tight group-hover:text-primary sm:text-3xl">
            {post.title}
          </h2>
        </a>
        <p class="mt-3 text-muted-foreground">{post.excerpt}</p>
        <div class="mt-4 text-xs text-muted-foreground flex flex-wrap items-center gap-3">
          <span>{badge.tier} · {post.readingTime} মিনিট পাঠ</span>
          {post.verification?.evidence?.length > 0 && (
            <span>· {badge.label} · {post.verification.evidence.length} প্রমাণ</span>
          )}
          {author && <span class="flex items-center gap-1">✍️ {author.shortName || author.name}</span>}
        </div>
      </div>
      {post.thumbnail && (() => {
        const avif = post.thumbnail.replace(/\.webp$/, '.avif');
        const src640 = post.thumbnail.replace(/\.webp$/, '-640.webp');
        return (
          <a href={href} class="block" aria-label={post.title}>
            <div class="aspect-[4/3] overflow-hidden rounded-md bg-muted sm:aspect-square">
              <picture>
                <source srcset={avif} type="image/avif" />
                <source srcset={`${src640} 640w, ${post.thumbnail} 1200w`} sizes="(max-width: 640px) 100vw, 400px" type="image/webp" />
                <img
                  src={post.thumbnail}
                  alt={post.thumbnailAlt || ""}
                  width="440"
                  height="330"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                />
              </picture>
            </div>
          </a>
        );
      })()}
    </article>
  ) : (
    <article class="group" hidden={hidden}>
      {post.thumbnail && (() => {
        const avif = post.thumbnail.replace(/\.webp$/, '.avif');
        const src640 = post.thumbnail.replace(/\.webp$/, '-640.webp');
        return (
          <a href={href} class="block" aria-label={post.title}>
            <div class="aspect-[16/10] overflow-hidden rounded-md bg-muted">
              <picture>
                <source srcset={avif} type="image/avif" />
                <source srcset={`${src640} 640w, ${post.thumbnail} 1200w`} sizes="(max-width: 640px) 100vw, 400px" type="image/webp" />
                <img
                  src={post.thumbnail}
                  alt={post.thumbnailAlt || ""}
                  width="640"
                  height="400"
                  loading="lazy"
                  decoding="async"
                  class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
                />
              </picture>
            </div>
          </a>
        );
      })()}
      <div class="mt-4">
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
          {category && (
            <a href={`/category/${category.slug}`}>
              <span class="category-pill" style={`background-color:${category.color}`}>
                {category.name}
              </span>
            </a>
          )}
          <VerificationBadge badge={badge} compact />
          {post.verification?.evidence?.length > 0 && (
            <span>· {post.verification.evidence.length} প্রমাণ</span>
          )}
          {post.demo && <span class="rounded border border-border px-1.5 py-0.5">ডেমো</span>}
          <time datetime={new Date(post.ts).toISOString()}>{formatDateTimeBDShort(post.ts)}</time>
        </div>
        <a href={href} class="mt-1 block py-1">
          <h3 class="font-serif text-xl font-semibold leading-snug group-hover:text-primary">
            {post.title}
          </h3>
        </a>
        <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{post.excerpt}</p>
        <div class="mt-3 text-xs text-muted-foreground flex flex-wrap items-center gap-3">
          <span>{post.readingTime} মিনিট পাঠ · {badge.label}</span>
          {post.verification?.evidence?.length > 0 && (
            <span>· {post.verification.evidence.length} প্রমাণ</span>
          )}
          {author && <span class="flex items-center gap-1">✍️ {author.shortName || author.name}</span>}
        </div>
      </div>
    </article>
  )
}