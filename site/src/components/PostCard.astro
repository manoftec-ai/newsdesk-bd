---
import { getCategory, getBadge, formatDate } from "../lib/news-data.js";
import VerificationBadge from "./VerificationBadge.astro";

const { post, variant = "default", hidden = false } = Astro.props;
const category = getCategory(post.category);
const badge = getBadge(post);
const href = `/article/${post.slug}`;
---

{
  variant === "compact" ? (
    <a href={href} class="group block" hidden={hidden}>
      <div class="flex flex-wrap items-center gap-2">
        {category && (
          <span class="category-pill" style={`background-color:${category.color}`}>
            {category.name}
          </span>
        )}
        <VerificationBadge badge={badge} compact />
      </div>
      <h3 class="mt-1.5 font-serif text-lg font-semibold leading-snug text-foreground group-hover:text-primary">
        {post.title}
      </h3>
      <div class="mt-1 text-xs text-muted-foreground">{formatDate(post.date)}</div>
    </a>
  ) : variant === "list" ? (
    <article class="group grid gap-6 border-b border-border/60 py-8 sm:grid-cols-[1fr_220px]" hidden={hidden}>
      <div>
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
          {category && (
            <a href={`/category/${category.slug}`}>
              <span class="category-pill" style={`background-color:${category.color}`}>
                {category.name}
              </span>
            </a>
          )}
          <VerificationBadge badge={badge} compact />
          {post.demo && <span class="rounded border border-border px-1.5 py-0.5">ডেমো</span>}
          <time datetime={post.date}>{formatDate(post.date)}</time>
        </div>
        <a href={href} class="mt-1 block py-1">
          <h2 class="font-serif text-2xl font-semibold leading-tight group-hover:text-primary sm:text-3xl">
            {post.title}
          </h2>
        </a>
        <p class="mt-3 text-muted-foreground">{post.excerpt}</p>
        <div class="mt-4 text-xs text-muted-foreground">
          {badge.tier} · {post.readingTime} মিনিট পাঠ
        </div>
      </div>
      {post.thumbnail && (
        <a href={href} class="block" aria-label={post.title}>
          <div class="aspect-[4/3] overflow-hidden rounded-md bg-muted sm:aspect-square">
            <img
              src={post.thumbnail}
              alt={post.thumbnailAlt || ""}
              width="440"
              height="330"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </div>
        </a>
      )}
    </article>
  ) : (
    <article class="group" hidden={hidden}>
      {post.thumbnail && (
        <a href={href} class="block" aria-label={post.title}>
          <div class="aspect-[16/10] overflow-hidden rounded-md bg-muted">
            <img
              src={post.thumbnail}
              alt={post.thumbnailAlt || ""}
              width="640"
              height="400"
              loading="lazy"
              class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
            />
          </div>
        </a>
      )}
      <div class="mt-4">
        <div class="flex flex-wrap items-center gap-2 text-xs text-muted-foreground">
          {category && (
            <a href={`/category/${category.slug}`}>
              <span class="category-pill" style={`background-color:${category.color}`}>
                {category.name}
              </span>
            </a>
          )}
          <VerificationBadge badge={badge} compact />
          {post.demo && <span class="rounded border border-border px-1.5 py-0.5">ডেমো</span>}
          <time datetime={post.date}>{formatDate(post.date)}</time>
        </div>
        <a href={href} class="mt-1 block py-1">
          <h3 class="font-serif text-xl font-semibold leading-snug group-hover:text-primary">
            {post.title}
          </h3>
        </a>
        <p class="mt-2 line-clamp-2 text-sm text-muted-foreground">{post.excerpt}</p>
        <div class="mt-3 text-xs text-muted-foreground">{post.readingTime} মিনিট পাঠ</div>
      </div>
    </article>
  )
}