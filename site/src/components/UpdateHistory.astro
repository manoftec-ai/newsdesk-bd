---
import Icon from "./Icon.astro";

const { updates = [], formatDate, formatTime } = Astro.props;

const labels = {
  verified: "যাচাইকৃত",
  confirmed: "নিশ্চিত",
  partial: "একক/আংশিক",
  suspect: "সন্দেহজনক",
};
---

{updates.length > 0 && (
  <div class="update-history border-l-2 border-primary/60 pl-4">
    <div class="text-sm font-bold">আপডেট ইতিহাস</div>
    <p class="mt-1 text-xs text-muted-foreground">
      এই সংবাদটি ধাপে ধাপে বদলাচ্ছে — প্রতিটি সংশোধন এখানে সংরক্ষিত (কখনো নীরবে মোছা হয় না)।
    </p>
    <ul class="mt-3 space-y-4">
      {updates.map((item) => (
        <li class="relative pl-5">
          <span class="absolute left-0 top-1.5 h-2 w-2 rounded-full bg-primary" aria-hidden="true" />
          <div class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
            <time datetime={item.date.toISOString ? item.date.toISOString() : ""} class="font-medium">
              {formatTime?.(item.date)}
            </time>
            {item.label && (
              <span class="text-muted-foreground">{item.label}</span>
            )}
          </div>
          {item.badge && (
            <div class="mt-0.5 inline-block text-[11px]">
              <span class="rounded bg-muted px-1.5 py-0.5">{labels[item.badge] ?? item.badge}</span>
            </div>
          )}
          <p class="mt-1 text-sm leading-relaxed">{item.note}</p>
        </li>
      ))}
    </ul>
  </div>
)}
