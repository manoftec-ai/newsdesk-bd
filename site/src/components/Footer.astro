---
import Icon from "./Icon.astro";
import { SITE, categories } from "../lib/news-data.js";
import { SOCIAL_LINKS } from "../config/theme.config.ts";

const { flush = false } = Astro.props;
---

<footer class:list={[flush ? "mt-0" : "mt-24", "border-t border-border/60"]}>
  <div class="mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-4">
    <div class="md:col-span-2">
      <div class="font-serif text-xl font-bold">{SITE.name}</div>
      <p class="mt-1 text-sm text-primary">{SITE.tagline}</p>
      <p class="mt-3 max-w-sm text-sm leading-relaxed text-muted-foreground">{SITE.description}</p>
      <form id="footer-newsletter" class="mt-4 flex max-w-sm gap-2" novalidate>
        <label for="footer-email" class="sr-only">ইমেইল</label>
        <input id="footer-email" name="email" type="email" required placeholder="ইমেইল — নিউজলেটার" autocomplete="email" class="flex-1 rounded-md border border-input bg-background px-3 py-2 text-sm focus:ring-2 focus:ring-ring" />
        <button type="submit" class="rounded-md bg-primary px-4 py-2 text-sm font-medium text-primary-foreground whitespace-nowrap">সাবস্ক্রাইব</button>
      </form>
      <p id="footer-newsletter-status" class="mt-2 text-xs text-muted-foreground" role="status" aria-live="polite"></p>
      <script is:inline>
        (function(){
          var f=document.getElementById('footer-newsletter');
          var s=document.getElementById('footer-newsletter-status');
          if(!f||!s) return;
          f.addEventListener('submit', async function(e){
            e.preventDefault();
            var email=document.getElementById('footer-email').value.trim();
            if(!email) return;
            s.textContent='পাঠানো হচ্ছে…';
            try{
              var r=await fetch('/api/contact',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({email:email,kind:'newsletter'})});
              var j=await r.json();
              s.textContent=j.ok ? 'সাবস্ক্রাইব সম্পন্ন — ধন্যবাদ!' : 'সাবস্ক্রিপশন এখন চালু হয়নি — পরে আবার চেষ্টা করুন।';
              if(j.ok) f.reset();
            }catch(e){ s.textContent='নেটওয়ার্ক সমস্যা — পরে আবার চেষ্টা করুন।'; }
          });
        })();
      </script>
      <div class="mt-4 flex items-center gap-3 text-muted-foreground">
        {SOCIAL_LINKS.filter((link) => link.href).map((link) => (
          <a href={link.href} aria-label={link.label} class="hover:text-foreground">
            <Icon name={link.icon} class="h-4 w-4" />
          </a>
        ))}
      </div>
    </div>
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">বিভাগসমূহ</div>
      <ul class="mt-3 space-y-2 text-sm">
        {categories.slice(0, 5).map((category) => (
          <li>
            <a href={`/category/${category.slug}`} class="text-foreground/80 hover:text-primary">
              {category.name}
            </a>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <div class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">সাইট</div>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/news" class="hover:text-primary">সব খবর</a></li>
        <li><a href="/tracked" class="hover:text-primary">ট্র্যাক করা গল্প</a></li>
        <li><a href="/factcheck" class="hover:text-primary">ফ্যাক্ট চেক</a></li>
        <li><a href="/districts" class="hover:text-primary">জেলার খবর</a></li>
        <li><a href="/corrections" class="hover:text-primary">সংশোধন নীতি</a></li>
        <li><a href="/editorial-policy" class="hover:text-primary">সম্পাদকীয় নীতি</a></li>
        <li><a href="/privacy" class="hover:text-primary">গোপনীয়তা নীতি</a></li>
        <li><a href="/terms" class="hover:text-primary">ব্যবহারের শর্তাবলী</a></li>
        <li><a href="/search" class="hover:text-primary">খুঁজুন</a></li>
        <li><a href="/about" class="hover:text-primary">আমাদের সম্পর্কে</a></li>
        <li><a href="/contact" class="hover:text-primary">যোগাযোগ</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-border/60">
    <div class="mx-auto flex max-w-6xl items-center justify-center px-5 py-5 text-center text-xs text-muted-foreground">
      &copy; {new Date().getFullYear()} {SITE.name} — সর্বস্বত্ব সংরক্ষিত।
    </div>
  </div>
</footer>