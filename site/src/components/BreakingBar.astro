---
const { items = [], label = "সর্বশেষ" } = Astro.props;
const rail = items.length > 0 ? [...items, ...items] : [];
---

<div class="ticker-band">
  <span class="ticker-label">{label}</span>
  <div class="ticker-viewport" role="region" aria-label="সর্বশেষ খবরের শিরোনাম">
    <div class="ticker-track">
      {rail.map((item) => (
        <a href={`/article/${item.slug}`}>{item.title}</a>
      ))}
    </div>
  </div>
</div>