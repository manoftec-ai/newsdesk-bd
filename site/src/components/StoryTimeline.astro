---
// StoryTimeline.astro — related stories sharing actors/sources, rendered from
// the committed site/data/event-graph.json (no JS). The reader-visible
// "কীভাবে উন্মোচিত হলো" event timeline and "সংস্করণ ইতিহাস" version ledger were
// removed 2026-09-24 by user request — the versions data stays in
// event-graph.json as background/audit, not shown to readers.
import { storyGraph } from "../lib/graph.js";

const { slug } = Astro.props;
const graph = storyGraph(slug);
const showRelated = Boolean(graph?.related?.length > 0);
---

{showRelated && (
  <aside class="related-stories mt-6 border-t border-border/60 pt-5">
    <div class="text-sm font-bold">সম্পর্কিত খবর</div>
    <p class="mt-0.5 text-xs text-muted-foreground">
      একই ব্যক্তি/প্রতিষ্ঠান বা একই সূত্রে উঠে আসা অন্য গল্প।
    </p>
    <ul class="mt-2 space-y-1">
      {graph.related.map((r) => (
        <li class="text-sm">
          <a
            href={`/article/${r.slug}`}
            class="underline-offset-2 hover:text-primary hover:underline"
          >
            {r.headline ?? `সংবাদ #${r.cluster_id}`}
          </a>
          <span class="ml-2 text-xs text-muted-foreground">
            {r.actor_links ? `সম্পৃক্ত ${r.actor_links} · ` : ""}
            {r.source_links}টি একই সূত্র
          </span>
        </li>
      ))}
    </ul>
  </aside>
)}
