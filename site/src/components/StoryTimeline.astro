---
// StoryTimeline.astro — "সংস্করণ ইতিহাস" (per-claim status ledger, append-only)
// and related stories sharing actors/sources. The event timeline
// ("কীভাবে উন্মোচিত হলো") was removed 2026-09-24 by user request.
// Static: renders the committed site/data/event-graph.json, no JS.
import { storyGraph, reasonLabel } from "../lib/graph.js";

const { slug, formatTime, formatDate } = Astro.props;
const graph = storyGraph(slug);
const showVersions = Boolean(graph?.versions?.some((c) => (c.periods?.length ?? 0) > 0));
const showRelated = Boolean(graph?.related?.length > 0);
const showAny = showVersions || showRelated;

const STATUS_LABELS = {
  OFFICIAL: "অফিসিয়াল",
  VERIFIED: "যাচাইকৃত",
  CORROBORATED: "নিশ্চিত",
  SINGLE_SOURCE: "একক সূত্র",
  CONFLICTING: "বিতর্কিত",
  UNCONFIRMED: "নিশ্চিত নয়",
  REFUTED: "অপপ্রচার",
  OUTDATED: "পুরনো",
};

const statusBn = (s) => STATUS_LABELS[s] ?? s;

const statusChipClass = (s) => ({
  OFFICIAL: "badge--verified",
  VERIFIED: "badge--verified",
  CORROBORATED: "badge--confirmed",
  SINGLE_SOURCE: "badge--partial",
  CONFLICTING: "badge--suspect",
  UNCONFIRMED: "badge--partial",
  REFUTED: "badge--suspect",
  OUTDATED: "badge--partial",
}[s] ?? "badge--partial");
---

{(showAny) && (
  <div class="story-timeline mt-6 border-t border-border/60 pt-5">
    {showVersions && (
      <section class="claim-versions mt-6" aria-label="সংস্করণ ইতিহাস">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h3 class="text-base font-bold">সংস্করণ ইতিহাস</h3>
          <span class="text-xs text-muted-foreground">
            প্রতিটি দাবির যাচাই-স্থিতির পূর্ণ রেকর্ড — কখনো নীরবে মোছা হয় না
          </span>
        </div>
        <div class="mt-3 space-y-2">
          {graph.versions.map((claim) => (claim.periods?.length ?? 0) > 0 && (
            <details class="claim-version-periods rounded border border-border/60">
              <summary class="flex flex-wrap items-center justify-between gap-2 px-3 py-2 text-sm">
                <span class="line-clamp-2">«{claim.claim_text}»</span>
                <span class="flex shrink-0 items-center gap-2">
                  <span class="text-xs text-muted-foreground">{claim.periods.length}টি পর্যায়</span>
                  {statusBn(claim.periods[claim.periods.length - 1].status) && (
                    <span class:list={["badge-chip", statusChipClass(claim.periods[claim.periods.length - 1].status)]}>
                      {statusBn(claim.periods[claim.periods.length - 1].status)}
                    </span>
                  )}
                </span>
              </summary>
              <ol class="border-t border-border/50 px-3 py-2 space-y-2">
                {claim.periods.map((p) => (
                  <li class="text-xs">
                    <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                      <span class:list={["badge-chip", statusChipClass(p.status)]}>
                        {statusBn(p.status)}
                      </span>
                      <span class="text-muted-foreground">
                        {formatDate?.(p.valid_from)}
                        {p.valid_until ? ` → ${formatDate?.(p.valid_until)}` : " → বর্তমান"}
                      </span>
                      <span class="rounded bg-muted px-1.5 py-0.5 text-[11px] text-muted-foreground">
                        {reasonLabel(p.reason)}
                      </span>
                    </div>
                    {(p.support_count != null || p.evidence_count != null) && (
                      <p class="mt-0.5 text-[11px] text-muted-foreground/80">
                        {p.support_count != null && `সমর্থন ${p.support_count}`}
                        {p.support_count != null && p.contradiction_count != null && " · "}
                        {p.contradiction_count != null && `দ্বন্দ্ব ${p.contradiction_count}`}
                        {p.evidence_count != null && ` · প্রমাণ ${p.evidence_count}`}
                        {p.confidence != null && ` · আস্থা ${Math.round(p.confidence)}%`}
                      </p>
                    )}
                  </li>
                ))}
              </ol>
            </details>
          ))}
        </div>
      </section>
    )}

    {showRelated && (
      <aside class="related-stories mt-5 border-t border-border/40 pt-3">
        <div class="text-sm font-bold">সম্পর্কিত খবর</div>
        <p class="mt-0.5 text-xs text-muted-foreground">
          একই ব্যক্তি/প্রতিষ্ঠান বা একই সূত্রে উঠে আসা অন্য গল্প।
        </p>
        <ul class="mt-2 space-y-1">
          {graph.related.map((r) => (
            <li class="text-sm">
              <a
                href={`/article/${r.slug}`}
                class="underline-offset-2 hover:text-primary hover:underline"
              >
                {r.headline ?? `সংবাদ #${r.cluster_id}`}
              </a>
              <span class="ml-2 text-xs text-muted-foreground">
                {r.actor_links ? `সম্পৃক্ত ${r.actor_links} · ` : ""}
                {r.source_links}টি একই সূত্র
              </span>
            </li>
          ))}
        </ul>
      </aside>
    )}
  </div>
)}