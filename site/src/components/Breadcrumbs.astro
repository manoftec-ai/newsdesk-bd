---
const { crumbs = [] } = Astro.props;
---

<nav aria-label="ব্রেডক্রাম্ব" class="mt-6 text-sm">
  <ol class="flex flex-wrap items-center gap-1.5 text-muted-foreground">
    <li>
      <a href="/" class="hover:text-primary">নীড়</a>
    </li>
    {crumbs.map((crumb, index) => (
      <li class="flex items-center gap-1.5">
        <span class="text-border">/</span>
        {index === crumbs.length - 1 ? (
          <span aria-current="page" class="text-foreground">{crumb.name}</span>
        ) : (
          <a href={crumb.href} class="hover:text-primary">{crumb.name}</a>
        )}
      </li>
    ))}
  </ol>
</nav>