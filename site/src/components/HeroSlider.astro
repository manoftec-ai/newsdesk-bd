---
// HeroSlider: the top-news carousel. Five latest stories, one viewport wide,
// swipeable with zero JavaScript (CSS scroll-snap) and buttons/dots as a tiny
// progressive enhancement.
//
// Deliberately minimal, per the theme rules:
// - no dependencies, no framework runtime, one inline <script> (~20 lines)
// - every slide is a plain <a> in the static HTML: crawlable, works with JS
//   disabled (first slide visible, the rest a scroll away)
// - no autoplay: motion only happens when the reader asks for it, and
//   `prefers-reduced-motion` gets instant jumps instead of smooth scrolling
// - LCP-safe: only slide 0 is eager/fetchpriority-high; the rest lazy-load,
//   all with width/height inside a fixed-aspect box (no layout shift)
import VerificationBadge from "./VerificationBadge.astro";
import { cleanAlt } from "../lib/image-alt.js";
import {
  getCategory,
  getBadge,
  getAuthor,
  formatDateTimeBDShort,
  formatDateBD,
  hasTimeComponent,
} from "../lib/news-data.js";

const { slides = [] } = Astro.props;
const items = slides.slice(0, 5);
---

{
  items.length > 0 && (
    <section class="mt-8" aria-label="সর্বশেষ খবর" aria-roledescription="carousel">
      <div class="hero-track" data-hero-track tabindex="0" role="group" aria-label="স্লাইড দেখতে স্ক্রল বা তীর চিহ্ন ব্যবহার করুন">
        {items.map((p, i) => {
          const badge = getBadge(p);
          const category = getCategory(p.category);
          const author = getAuthor(p.author);
          return (
            <article class="hero-slide" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}: ${p.title}`}>
              <a href={`/article/${p.slug}`} class="lead-article block">
                {p.thumbnail && (
                  <div class="aspect-[16/9] overflow-hidden bg-muted md:aspect-[21/9]">
                    <img
                      src={p.thumbnail}
                      alt={cleanAlt(p.thumbnailAlt)}
                      width="1200"
                      height="630"
                      loading={i === 0 ? "eager" : "lazy"}
                      fetchpriority={i === 0 ? "high" : "auto"}
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  </div>
                )}
                <div class="lead-article-content">
                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    {category && (
                      <span class="category-pill" style={`background-color:${category.color}`}>
                        {category.name}
                      </span>
                    )}
                    <VerificationBadge badge={badge} />
                    <time datetime={p.date} class="text-muted-foreground">
                      {hasTimeComponent(p.date)
                        ? formatDateTimeBDShort(new Date(p.date).getTime())
                        : formatDateBD(p.date)}
                    </time>
                    {author && (
                      <span class="flex items-center gap-1 text-muted-foreground">
                        <span aria-hidden="true">✍️</span>
                        {author.shortName || author.name}
                      </span>
                    )}
                  </div>
                  <h2>{p.title}</h2>
                  <div class="mt-4 text-sm font-medium text-primary">
                    {p.readingTime} মিনিট পাঠ →
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
      {items.length > 1 && (
        <div class="hero-nav" role="group" aria-label="স্লাইড নিয়ন্ত্রণ">
          <button type="button" class="hero-arrow" data-hero-prev aria-label="আগের খবর">
            ‹
          </button>
          <div class="hero-dots" role="group" aria-label="স্লাইড নির্বাচন">
            {items.map((p, i) => (
              <button
                type="button"
                class="hero-dot"
                data-hero-dot={i}
                aria-label={`স্লাইড ${i + 1}: ${p.title}`}
                aria-current={i === 0 ? "true" : "false"}
              />
            ))}
          </div>
          <button type="button" class="hero-arrow" data-hero-next aria-label="পরের খবর">
            ›
          </button>
        </div>
      )}
      <script>
        // Buttons + dots + arrow keys. The carousel itself is pure CSS
        // scroll-snap, so this whole block is optional enhancement.
        const root = document.currentScript.parentElement;
        const track = root.querySelector("[data-hero-track]");
        const dots = [...root.querySelectorAll("[data-hero-dot]")];
        const prev = root.querySelector("[data-hero-prev]");
        const next = root.querySelector("[data-hero-next]");
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        const count = () => track.children.length;
        const current = () => Math.min(count() - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
        const go = (i) => {
          const j = (i + count()) % count();
          track.children[j].scrollIntoView({ behavior: reduce ? "auto" : "smooth", block: "nearest", inline: "start" });
        };
        const paint = () => {
          const c = current();
          dots.forEach((d, i) => d.setAttribute("aria-current", String(i === c)));
        };
        prev?.addEventListener("click", () => go(current() - 1));
        next?.addEventListener("click", () => go(current() + 1));
        dots.forEach((d, i) => d.addEventListener("click", () => go(i)));
        track.addEventListener("scroll", () => requestAnimationFrame(paint), { passive: true });
        track.addEventListener("keydown", (e) => {
          if (e.key === "ArrowLeft") { e.preventDefault(); go(current() - 1); }
          if (e.key === "ArrowRight") { e.preventDefault(); go(current() + 1); }
        });
        paint();
      </script>
    </section>
  )
}

<style>
  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hero-track::-webkit-scrollbar {
    display: none;
  }
  .hero-track:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .hero-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-track {
      scroll-behavior: smooth;
    }
  }
  .hero-nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .hero-arrow {
    width: 2rem;
    height: 2rem;
    border-radius: 9999px;
    border: 1px solid var(--border, #e5e5e5);
    font-size: 1.1rem;
    line-height: 1;
  }
  .hero-dots {
    display: flex;
    gap: 0.5rem;
  }
  .hero-dot {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 9999px;
    background: currentColor;
    opacity: 0.3;
  }
  .hero-dot[aria-current="true"] {
    opacity: 1;
  }
</style>
