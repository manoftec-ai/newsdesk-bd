---
// HeroSlider: the top-news carousel. Five latest stories, one viewport wide.
// It moves on its own every 5 seconds (user asked for auto-move); the motion
// stops the moment the reader takes over — hover, touch-hold, keyboard focus,
// or a hidden tab — and never starts at all under prefers-reduced-motion.
//
// Still minimal, per the theme rules:
// - swiping itself is pure CSS scroll-snap (works with JS disabled; every
//   slide is a plain crawlable <a>)
// - one inline <script>, no dependencies, no framework runtime
// - arrows sit ON the slider (overlaid left/right), not above or below it
// - LCP-safe: only slide 0 is eager/fetchpriority-high; the rest lazy-load,
//   all with width/height inside a fixed-aspect box (no layout shift)
import VerificationBadge from "./VerificationBadge.astro";
import { cleanAlt } from "../lib/image-alt.js";
import {
  getCategory,
  getBadge,
  getAuthor,
  formatDateTimeBDShort,
  formatDateBD,
  hasTimeComponent,
} from "../lib/news-data.js";

const { slides = [] } = Astro.props;
const items = slides.slice(0, 5);
---

{
  items.length > 0 && (
    <section class="hero-wrap mt-8" data-hero aria-label="সর্বশেষ খবর" aria-roledescription="carousel">
      <div class="hero-track" data-hero-track tabindex="0" role="group" aria-label="স্লাইড দেখতে স্ক্রল বা তীর চিহ্ন ব্যবহার করুন">
        {items.map((p, i) => {
          const badge = getBadge(p);
          const category = getCategory(p.category);
          const author = getAuthor(p.author);
          return (
            <article class="hero-slide" aria-roledescription="slide" aria-label={`${i + 1} / ${items.length}: ${p.title}`}>
              <a href={`/article/${p.slug}`} class="lead-article block">
                {/* The photo box always renders, even with no photo: every
                    slide then has identical geometry and the strip never jumps
                    in height between slides. */}
                <div class="aspect-[16/9] overflow-hidden bg-muted md:aspect-[21/9]">
                  {p.thumbnail && (
                    <img
                      src={p.thumbnail}
                      alt={cleanAlt(p.thumbnailAlt)}
                      width="1200"
                      height="630"
                      loading={i === 0 ? "eager" : "lazy"}
                      fetchpriority={i === 0 ? "high" : "auto"}
                      decoding="async"
                      class="h-full w-full object-cover"
                    />
                  )}
                </div>
                <div class="lead-article-content">
                  <div class="flex flex-wrap items-center gap-2 text-xs">
                    {category && (
                      <span class="category-pill" style={`background-color:${category.color}`}>
                        {category.name}
                      </span>
                    )}
                    <VerificationBadge badge={badge} />
                    <time datetime={p.date} class="text-muted-foreground">
                      {hasTimeComponent(p.date)
                        ? formatDateTimeBDShort(new Date(p.date).getTime())
                        : formatDateBD(p.date)}
                    </time>
                    {author && (
                      <span class="flex items-center gap-1 text-muted-foreground">
                        <span aria-hidden="true">✍️</span>
                        {author.shortName || author.name}
                      </span>
                    )}
                  </div>
                  <h2>{p.title}</h2>
                  <div class="mt-4 text-sm font-medium text-primary">
                    {p.readingTime} মিনিট পাঠ →
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>
      {items.length > 1 && (
        <>
          <button type="button" class="hero-arrow hero-arrow-left" data-hero-prev aria-label="আগের খবর">
            ‹
          </button>
          <button type="button" class="hero-arrow hero-arrow-right" data-hero-next aria-label="পরের খবর">
            ›
          </button>
        </>
      )}
      <script>
        // Auto-advance every 5s, but only while the reader is NOT engaged:
        // hover, touch, focus, or a hidden tab all pause it. Reduced-motion
        // users never get auto-motion at all. Buttons restart the clock so a
        // manual tap is never immediately overridden.
        //
        // NOTE: Astro compiles this to type="module", where
        // document.currentScript is null — so the root is found by query,
        // never by currentScript.
        const AUTOPLAY_MS = 5000;
        const root = document.querySelector("section[data-hero]");
        const track = root?.querySelector("[data-hero-track]");
        if (track) {
          const prev = root.querySelector("[data-hero-prev]");
          const next = root.querySelector("[data-hero-next]");
          // Reduced motion changes HOW it moves (an instant cut, no animated
          // scroll) — it must not switch rotation off, or the hero sits frozen
          // for exactly the readers least served by a static hero.
          const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
          const count = () => track.children.length;
          const current = () => Math.min(count() - 1, Math.max(0, Math.round(track.scrollLeft / track.clientWidth)));
          const go = (i, smooth = false) => {
            const j = (i + count()) % count();
            // 2026-10-02: this used scrollIntoView(), which scrolls EVERY
            // scrollable ancestor — so each 5-second auto-advance also yanked
            // the PAGE vertically back up to the hero. A reader scrolling down
            // was thrown back to the top every five seconds. The track is
            // scrolled directly instead; nothing outside it can move.
            // .hero-slide is flex:0 0 100%, so one slide is exactly one
            // clientWidth — no measuring, no layout read.
            //
            // `smooth` is for the READER's own arrow/dot/key press only. The
            // 5-second auto-advance must be an instant cut: a programmatic
            // SMOOTH scroll under `scroll-snap-type: x mandatory` can settle on
            // a fractional offset, which left the hero showing half of one
            // slide and half of the next (reproduced at 7s and 15s, aligned
            // before the first tick). A cut always lands on a snap point.
            track.scrollTo({ left: j * track.clientWidth, behavior: smooth ? "smooth" : "auto" });
          };
          let timer = null;
          const play = () => {
            if (timer || count() < 2) return;
            // Warm the NEXT slide's photo while the current one is on screen.
            // The auto-advance is an instant cut (see go()), so a lazy image
            // that has not started downloading shows as an empty box the
            // moment the slide appears - which is exactly the blank hero seen
            // in a full-page screenshot. Fetching it early costs nothing (the
            // browser caches it) and removes the flash on every wrap.
            const warm = () => {
              const next = track.children[(current() + 1) % count()];
              const img = next?.querySelector("img");
              if (img?.src && !img.complete) new Image().src = img.src;
            };
            warm();
            timer = setInterval(() => { go(current() + 1); warm(); }, AUTOPLAY_MS);
          };
          const stop = () => {
            if (timer) { clearInterval(timer); timer = null; }
          };
          const nudge = (i) => { stop(); go(i, !reduce); play(); };
          prev?.addEventListener("click", () => nudge(current() - 1));
          next?.addEventListener("click", () => nudge(current() + 1));
          // Only three things pause it, and none of them is "the reader's
          // mouse happens to be over the hero": a keyboard user reading the
          // controls, and a backgrounded tab.
          track.addEventListener("focusin", stop);
          track.addEventListener("focusout", play);
          document.addEventListener("visibilitychange", () => (document.hidden ? stop() : play()));
          track.addEventListener("keydown", (e) => {
            if (e.key === "ArrowLeft") { e.preventDefault(); nudge(current() - 1); }
            if (e.key === "ArrowRight") { e.preventDefault(); nudge(current() + 1); }
          });
          play();
        }
      </script>
    </section>
  )
}

<style>
  .hero-wrap {
    position: relative;
  }
  .hero-track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }
  .hero-track::-webkit-scrollbar {
    display: none;
  }
  .hero-track:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }
  .hero-slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }
  /* Uniform slides: the photo box is a fixed ratio and the headline is
     clamped to two lines, so every slide has the same height and the strip
     never jumps as it moves. */
  .hero-slide h2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  /* The meta row (category + badge + date + author) must stay one line: a long
     outlet name wrapping to two lines would make that slide taller. */
  .hero-slide .lead-article-content > .flex {
    flex-wrap: nowrap;
    overflow: hidden;
    white-space: nowrap;
  }
  .hero-slide .lead-article-content > .flex > * {
    flex: none;
  }
  // 2026-10-02: no `scroll-behavior: smooth` here on purpose. It would make
  // scrollTo({behavior: "auto"}) smooth as well, and a programmatic smooth
  // scroll under mandatory snapping settles off-snap — the hero was left
  // showing half of one slide and half of the next. Motion now comes only from
  // the reader pressing an arrow.
  .hero-arrow {
    position: absolute;
    /* ~image-center: the slide is a 16/9 (21/9 on desktop) photo plus a text
       block below, so 50% would land on the headline. This keeps the arrows
       over the photo at every breakpoint without any measuring code. */
    top: 32%;
    transform: translateY(-50%);
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 9999px;
    border: none;
    background: rgba(0, 0, 0, 0.45);
    color: #fff;
    font-size: 1.4rem;
    line-height: 1;
    opacity: 0.8;
    z-index: 1;
  }
  .hero-arrow:hover,
  .hero-arrow:focus-visible {
    opacity: 1;
  }
  .hero-arrow-left {
    left: 0.75rem;
  }
  .hero-arrow-right {
    right: 0.75rem;
  }
</style>
