---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/news-data.js";
---

<BaseLayout
  title={`গোপনীয়তা নীতি — ${SITE.name}`}
  description={`${SITE.name} — আমরা কী কী তথ্য সংগ্রহ করি, করি না এবং সেগুলো কীভাবে ব্যবহৃত হয়।`}
  canonical={`${SITE.url}/privacy`}
>
  <div class="mx-auto max-w-3xl px-5">
    <Breadcrumbs crumbs={[{ name: "গোপনীয়তা নীতি", href: "/privacy", current: true }]} />
    <header class="mt-6 border-b border-border/60 pb-4">
      <h1 class="font-serif text-4xl font-bold">গোপনীয়তা নীতি</h1>
      <p class="mt-2 text-muted-foreground">
        {SITE.name} একটি সংবাদ ও তথ্যযাচাই সাইট। আমাদের সাইটে ব্যক্তিগত পরিচয় ছাড়াই খবর পড়া যায় —
        গোপনীয়তাকে আমরা তাই হালকাভাবে নিই না।
      </p>
    </header>

    <div class="prose prose-lg prose-brown dark:prose-invert mt-8">
      <h2>সংক্ষেপে</h2>
      <ul>
        <li>আমরা কোনো অ্যাকাউন্ট, রেজিস্ট্রেশন বা সাবস্ক্রিপশন চাই না।</li>
        <li>আমরা আপনার নাম, ইমেইল, ঠিকানা বা ফোন নম্বর সংগ্রহ করি না।</li>
        <li>আমরা কোনো বিজ্ঞাপন বা বিজ্ঞাপন-ট্র্যাকিং কুকি ব্যবহার করি না।</li>
        <li>সাইট পরিচালনার জন্য প্রয়োজনীয় প্রযুক্তিগত তথ্য (নিচে) একটি সার্ভিস প্রোভাইডারের মাধ্যমে প্রক্রিয়া হয়।</li>
      </ul>

      <h2>আমরা যা সংগ্রহ করি না</h2>
      <p>
        এই সাইট পড়তে হলে আপনাকে কোনো তথ্য দিতে হয় না। আমাদের কাছে আপনার ব্যক্তিগত তথ্য জমা রাখার কোনো
        ব্যবস্থাই নেই — মন্তব্য ব্যবস্থা, লগইন, নিউজলেটার ফর্ম বা অ্যাকাউন্ট ড্যাশবোর্ড চালু নেই। যোগাযোগ
        পাতার তথ্য আমাদের কাছে পাঠানো হয় না (<a href="/contact">যোগাযোগ</a> পাতা কীভাবে কাজ করে দেখুন)।
      </p>

      <h2>হোস্টিং ও সার্ভার লগ</h2>
      <p>
        সাইটটি <strong>Vercel</strong>-এর সার্ভারে হোস্ট করা হয়। সার্ভার লগে স্ট্যান্ডার্ড প্রযুক্তিগত
        তথ্য রেকর্ড হয় — যেমন আপনার আইপি ঠিকানা, অ্যাপ্রক্সিমেট অবস্থান, ব্রাউজার/ডিভাইসের ধরন, সময় এবং
        কোন পাতাটি দেখা হয়েছে। এগুলো স্ক্যাম, নিরাপত্তা নিশ্চিতকরণ ও সাইট পরিচালনার জন্য ব্যবহৃত হয়,
        পরিচয় চেনার উদ্দেশ্যে নয়। বিস্তারিত দেখুন Vercel-এর
        <a href="https://vercel.com/legal/privacy-policy" target="_blank" rel="noopener"> গোপনীয়তা নীতি</a>।
      </p>

      <h2>ভিজিট পরিসংখ্যান (Vercel Insights)</h2>
      <p>
        আমরা <strong>Vercel Insights</strong> নামের একটি পরিসংখ্যান পরিষেবার মাধ্যমে পেজ ভিউ ও
        ওয়েব-ভাইটাল (লোডিং গতি ইত্যাদি) পরিমাপ করি। এই পরিসংখ্যান সমষ্টিভিত্তিক — কোনো নির্দিষ্ট
        ব্যক্তির সঙ্গে সংযুক্ত নয়। এগুলো দিয়ে আমরা বুঝি কোন পাতাগুলো দরকারি, যেন সাইটটি দ্রুত ও
        নির্ভরযোগ্য থাকে।
      </p>

      <h2>আপনার ব্রাউজারে সংরক্ষিত তথ্য</h2>
      <p>
        অন্ধকার/আলো থিমের পছন্দ আপনার নিজের ব্রাউজারে (localStorage) গচ্ছিত থাকে — এটি আমাদের কাছে
        পাঠানো হয় না। সাইট চালাতে আমরা বিজ্ঞাপন-ট্র্যাকিং কুকি ব্যবহার করি না।
      </p>

      <h2>বাহ্যিক লিংক</h2>
      <p>
        প্রতিটি সংবাদের সাথে উৎসের লিংক থাকে। কোনো লিংকে ক্লিক করলে আপনি সেই বাইরের ওয়েবসাইটে চলে
        যান — ঐ সাইটের নিজস্ব গোপনীয়তা নীতি ও নিয়ম প্রযোজ্য হবে।
      </p>

      <h2>আপনার অধিকার</h2>
      <p>
        বাংলাদেশের <strong>ব্যক্তিগত তথ্য সুরক্ষা আইন ২০২৩</strong>-এর পাশাপাশি ইউরোপীয় ইউনিয়নের
        (GDPR) নীতির সাথেও আমরা সামঞ্জস্যপূর্ণ থাকতে চাই। যেহেতু আমরা নাম, ঠিকানা ইত্যাদি কোনো
        ব্যক্তিগত তথ্য রাখি না, তাই ঠিকানা-সংক্রান্ত কোনাে অধিকার প্রয়োগের প্রয়োজন সাধারণত পড়ে না।
        এরপরও কোনো প্রশ্ন বা অভিযোগ থাকলে <a href="/contact">যোগাযোগ</a> পাতায় জানান।
      </p>

      <h2>নীতির পরিবর্তন</h2>
      <p>
        প্রযুক্তিগত বা আইনগত প্রয়োজনে নীতি হালনাগাদ করলে নিচে তার তারিখ আপডেট করা হবে এবং এই পাতাতেই
        সবসময় সর্বশেষ সংস্করণ প্রকাশিত থাকবে।
      </p>

      <p class="text-sm text-muted-foreground">সর্বশেষ হালনাগাদ: ২৩ সেপ্টেম্বর ২০২৬</p>
    </div>
  </div>
</BaseLayout>