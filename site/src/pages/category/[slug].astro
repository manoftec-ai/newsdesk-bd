---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { categories, postsByCategory, getCategory, SITE } from "../../lib/news-data.js";

export async function getStaticPaths() {
  return categories.map((category) => ({
    params: { slug: category.slug },
    props: { category },
  }));
}

const { category } = Astro.props;
const posts = await postsByCategory(category.slug);
// T3: unique meta description per beat (falls back to the old template when a
// blurb is missing), and a real empty-state for beats with no stories yet.
const pageDescription = category.blurb || `${category.name} বিভাগের যাচাই-করা সংবাদ।`;
const siblingBeats = categories.filter((c) => c.slug !== category.slug && c.slug !== "latest");
---

<BaseLayout
  title={`${category.name} সংবাদ — ${SITE.name}`}
  description={pageDescription}
  canonical={`${SITE.url}/category/${category.slug}`}
>
  <div class="mx-auto max-w-6xl px-5">
    <Breadcrumbs
      crumbs={[{ name: category.name, href: `/category/${category.slug}`, current: true }]}
    />
    <header class="mt-6 border-b border-border/60 pb-4">
      <div class="flex items-center gap-3">
        <span class="category-pill" style={`background-color:${category.color}`}>
          {category.name}
        </span>
        <span class="text-sm text-muted-foreground">{posts.length}টি সংবাদ</span>
      </div>
      <h1 class="mt-3 font-serif text-4xl font-bold">{category.name} সংবাদ</h1>
      {category.blurb && (
        <p class="mt-2 max-w-2xl leading-relaxed text-muted-foreground">{category.blurb}</p>
      )}
    </header>

    {posts.length > 0 ? (
      <div class="mt-8">
        {posts.map((post) => (
          <PostCard post={post} variant="list" />
        ))}
      </div>
    ) : (
      <div class="mt-8">
        <p class="text-muted-foreground">
          এই বিভাগে এখনো কোনো সংবাদ প্রকাশিত হয়নি — প্রথম প্রতিবেদন এলে এখানেই দেখা যাবে।
        </p>
        <p class="mt-4 text-sm font-medium">ততক্ষণে অন্য বিভাগ দেখুন:</p>
        <div class="mt-2 flex flex-wrap gap-2">
          {siblingBeats.map((beat) => (
            <a
              href={`/category/${beat.slug}`}
              class="category-pill"
              style={`background-color:${beat.color}`}
            >
              {beat.name}
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</BaseLayout>