---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/news-data.js";
---

<BaseLayout
  title={`সম্পাদকীয় নীতি ও স্বচ্ছতা — ${SITE.name}`}
  description={`${SITE.name}-এর সম্পাদকীয় নীতি — উৎস ও যাচাই, স্বয়ংক্রিয় উৎপাদনের স্বচ্ছ ঘোষণা, সংশোধন, ফ্যাক্ট চেক ও স্বার্থের দ্বন্দ্ব।`}
  canonical={`${SITE.url}/editorial-policy`}
>
  <div class="mx-auto max-w-3xl px-5">
    <Breadcrumbs
      crumbs={[{ name: "সম্পাদকীয় নীতি ও স্বচ্ছতা", href: "/editorial-policy", current: true }]}
    />
    <header class="mt-6 border-b border-border/60 pb-4">
      <h1 class="font-serif text-4xl font-bold">সম্পাদকীয় নীতি ও স্বচ্ছতা</h1>
      <p class="mt-2 text-muted-foreground">
        আমরা কীভাবে খবর বাছাই, যাচাই ও প্রকাশ করি — এবং স্বয়ংক্রিয় উৎপাদন নিয়ে আমাদের খোলা ঘোষণা।
      </p>
    </header>

    <div class="prose prose-lg prose-brown dark:prose-invert mt-8">
      <h2>আমাদের মিশন</h2>
      <p>
        {SITE.name} একটি স্বয়ংক্রিয় সংবাদ ডেস্ক। একই ঘটনার একাধিক প্রকাশিত প্রতিবেদন অটো-বাছাই করে
        যাচাই করা হয় এবং একটি মূল, প্রমাণসহ প্রতিবেদন প্রকাশিত হয় — যেন পাঠক এক জায়গায় নির্ভরযোগ্য
        ছবি পান। বিস্তারিত: <a href="/about">আমাদের সম্পর্কে</a>।
      </p>

      <h2>উৎস ও যাচাই</h2>
      <ul>
        <li>প্রতিটি সংবাদের প্রতিটি বক্তব্য সূত্রে ফিরে যেতে হবে — বানোয়াট তথ্য নয় আমাদের নীতি।</li>
        <li>একই ঘটনার একাধিক অপেক্ষাকৃত বিশ্বস্ত সূত্রের মিলই প্রকাশের ভিত্তি।</li>
        <li>একক সূত্র বা আংশিক তথ্যের প্রতিবেদন পৃথকভাবে চিহ্নিত থাকে।</li>
        <li>প্রতিটি সংবাদে <em>সূত্র</em>র তালিকা ও <em>যাচাই-ব্যাজ</em> সবসময় দেখা যায়।</li>
      </ul>

      <h2>স্বয়ংক্রিয় ও এআই-সহায়তায় উৎপাদন — খোলা ঘোষণা</h2>
      <p>
        <strong> হ্যাঁ, এই সাইটের প্রতিবেদনগুলো কম্পিউটার-সহায়তায় (এআই-নির্ভর পাইপলাইনে) খসড়া
        প্রস্তুত করে যাচাই প্রক্রিয়ার পর প্রকাশ করা হয়।</strong> এই স্বচ্ছতা আমাদের প্রতিশ্রুতি:
      </p>
      <ul>
        <li>
          এআই-সহায়ক খসড়া <em>কখনোই</em> নিজস্ব তথ্য বানায় না — প্রতিটি দাবি সূত্র লাইনের সাথে
          বাঁধা থাকে।
        </li>
        <li>
          পাইপলাইন সূত্রগুলোর তালিকা, যাচাই-স্তর ও প্রমাণ সবসময় সংবাদ পেজে রাখে — খসড়া সম্পূর্ণ
          পাঠকের কাছে প্রকাশ করা হয়।
        </li>
        <li>
          প্রকাশ খুবই ঘন ঘন স্বয়ংক্রিয়ভাবে হয়; ফলে ভুল ধরার প্রক্রিয়া ফাস্ট-ট্র্যাক থাকে — দেখুন{' '}
          <a href="/corrections">সংশোধন নীতি</a>।
        </li>
      </ul>

      <h2>যাচাই-ব্যাজ</h2>
      <ul>
        <li><strong>যাচাইকৃত:</strong> অফিসিয়াল সূত্রে নিশ্চিত — প্রকাশের জন্য প্রস্তুত।</li>
        <li><strong>নিশ্চিত:</strong> একাধিক বিশ্বস্ত পত্রিকায় একমত — রুটিন সংবাদের জন্য যথেষ্ট।</li>
        <li><strong>একক/আংশিক:</strong> একক সূত্র বা আংশিক তথ্য — চূড়ান্ত নয়।</li>
        <li><strong>সন্দেহজনক:</strong> যাচাই হয়নি — প্রকাশযোগ্য নয়।</li>
      </ul>

      <h2>সংশোধন ও প্রতিকার</h2>
      <p>
        সত্যতা আমাদের মূল মূল্য — ভুল হলে তা স্বীকার ও লিপিবদ্ধ করা হয়, পুরনো লেখা মুছে ফেলা হয় না।
        বিস্তারিত নিয়ম ও লগ: <a href="/corrections">সংশোধন নীতি</a>।
      </p>

      <h2>ফ্যাক্ট চেক ও গুজব</h2>
      <p>
        পরস্পর-বিরোধী বা শোরগোলপূর্ণ তথ্যের ক্ষেত্রে আমরা গুজব শনাক্ত ও ফ্যাক্ট-চেক প্রকাশ করি:{' '}
        <a href="/factcheck">ফ্যাক্ট চেক পাতা</a>।
      </p>

      <h2>ট্র্যাক করা গল্প ও ঘটনাপঞ্জি</h2>
      <p>
        চলমান গুরুত্বপূর্ণ ঘটনা (যেমন ইরান-ইসরায়েল যুদ্ধ) একটি করে <a href="/ghotona">ঘটনাপঞ্জি</a>{' '}
        পাতায় একসাথে রাখা হয় এবং <a href="/tracked">ট্র্যাক করা গল্প</a> হিসেবে হালনাগাদ চলতে থাকে —
        যাতে পাঠকদের সময়ের সাথে তথ্য অনুসরণ করা সহজ হয়।
      </p>

      <h2>স্বার্থের দ্বন্দ্ব ও বাণিজ্যিক স্বাধীনতা</h2>
      <ul>
        <li>
          আমরা বর্তমানে কোনো বিজ্ঞাপন, স্পনসর বা পে-টু-পোস্ট রাখি না — সাংবাদিক সিদ্ধান্ত বাণিজ্যিক
          চাপের অধীন নয়।
        </li>
        <li>উৎস নির্বাচন হয় ঘটনার গুরুত্ব ও সূত্রের বিশ্বাসযোগ্যতার ভিত্তিতে।</li>
      </ul>

      <h2>পাঠকের সাথে যোগাযোগ</h2>
      <p>
        সংশোধন, অভিযোগ, তথ্যের প্রতিবাদ বা পরামর্শ পাঠাতে <a href="/contact">যোগাযোগ</a> পাতা ব্যবহার
        করুন। মন্তব্য ব্যবস্থা চালু নেই — তাই প্রসঙ্গভিত্তিক প্রতিক্রিয়া আমাদের এই পাতাতেই স্বাগত।
      </p>

      <p class="text-sm text-muted-foreground">সর্বশেষ হালনাগাদ: ২৩ সেপ্টেম্বর ২০২৬</p>
    </div>
  </div>
</BaseLayout>