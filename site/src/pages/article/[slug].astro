---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import VerificationBadge from "../../components/VerificationBadge.astro";
import UpdateHistory from "../../components/UpdateHistory.astro";
import Icon from "../../components/Icon.astro";

import {
  getCollection,
  render,
} from "astro:content";
import {
  SITE,
  getAuthor,
  getCategory,
  getBadge,
  getVerdict,
  formatDate,
  formatTime,
  formatDateTimeBD,
  formatDateTimeBDShort,
  relatedPosts,
} from "../../lib/news-data.js";
import { eventsForPost } from "../../lib/events.js";

export async function getStaticPaths() {
  return (await getCollection("news", ({ data }) => !data.draft)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const post = {
  slug: entry.id,
  ...entry.data,
  date: formatDate(entry.data.date),
  year: entry.data.date.getFullYear(),
  updated: entry.data.updated ? formatDate(entry.data.updated) : undefined,
  readingTime: entry.data.readingTime ?? 1,
};

const category = getCategory(post.category);
const author = getAuthor(post.author);
const badge = getBadge(post);
const related = await relatedPosts(post);
const matchedEvents = eventsForPost(post);

const isoDate = (date) => (date ? new Date(date).toISOString() : undefined);
const pageTitle = post.seoTitle ?? `${post.title} — ${SITE.name}`;
const description = post.seoDescription ?? post.excerpt;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      headline: post.title,
      description,
      articleSection: category?.name,
      datePublished: isoDate(entry.data.date),
      ...(entry.data.updated ? { dateModified: isoDate(entry.data.updated) } : {}),
      inLanguage: post.lang,
      keywords: (post.tags ?? []).join(", "),
      isAccessibleForFree: true,
      author: { "@type": "Organization", name: author?.name ?? SITE.name, url: SITE.url },
      publisher: { "@type": "Organization", name: SITE.name, url: SITE.url },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": `${SITE.url}/article/${post.slug}`,
      },
      ...(post.thumbnail ? { image: `${SITE.url}${post.thumbnail}` } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "নীড়",
          item: `${SITE.url}/`,
        },
        ...(category
          ? [
              {
                "@type": "ListItem",
                position: 2,
                name: category.name,
                item: `${SITE.url}/category/${category.slug}`,
              },
            ]
          : []),
        {
          "@type": "ListItem",
          position: category ? 3 : 2,
          name: post.title,
          item: `${SITE.url}/article/${post.slug}`,
        },
      ],
    },
    ...(post.faq?.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${SITE.url}/article/${post.slug}#faq`,
            mainEntity: post.faq.map((item) => ({
              "@type": "Question",
              name: item.q,
              acceptedAnswer: { "@type": "Answer", text: item.a },
            })),
          },
        ]
      : []),
  ],
};

const shareUrl = `${SITE.url}/article/${post.slug}`;
const shareLinks = [
  {
    name: "X",
    href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.title)}`,
  },
  {
    name: "ফেসবুক",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
  },
  {
    name: "হোয়াটসঅ্যাপ",
    href: `https://wa.me/?text=${encodeURIComponent(post.title)}%20${encodeURIComponent(shareUrl)}`,
  },
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonical={`${SITE.url}/article/${post.slug}`}
  ogType="article"
  ogImage={post.thumbnail}
  jsonLd={jsonLd}
  language={post.lang === "en" ? "en" : "bn"}
>
  <div class="mx-auto max-w-4xl px-5">
    <Breadcrumbs
      crumbs={[
        ...(category ? [{ name: category.name, href: `/category/${category.slug}` }] : []),
        { name: "সংবাদ", href: `/article/${post.slug}`, current: true },
      ]}
    />
    <article class="mt-8">
      <header class="border-b border-border/60 pb-6">
        <div class="flex flex-wrap items-center gap-2">
          {category && (
            <a href={`/category/${category.slug}`} aria-label={category.name}>
              <span class="category-pill" style={`background-color:${category.color}`}>
                {category.name}
              </span>
            </a>
          )}
          <VerificationBadge badge={badge} tier={post.verification?.tier} />
          {post.corrected && (
            <span class="badge-chip badge--corrected" role="note" title="এই প্রতিবেদন সংশোধন করা হয়েছে">
              সংশোধিত
            </span>
          )}
          {post.tracked && (
            <a href="/tracked" class="tracked-chip" aria-label="ট্র্যাক করা গল্পের তালিকা">
              ট্র্যাক করা
            </a>
          )}
        </div>

        <h1 class="mt-4 font-serif text-3xl font-bold leading-tight sm:text-4xl">
          {post.title}
        </h1>

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
          <span class="flex items-center gap-1.5">
            <Icon name="calendar" class="h-4 w-4" />
            <time datetime={entry.data.date.toISOString()}>{formatDateTimeBD(post.ts)}</time>
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="clock" class="h-4 w-4" />
            {post.readingTime} মিনিট পাঠ
          </span>
          {post.tracked && post.lastChecked && (
            <span class="flex items-center gap-1.5">
              <Icon name="eye" class="h-4 w-4" />
              <span>
                শেষ চেক:{" "}
                <time datetime={isoDate(post.lastChecked)}>{formatDate(post.lastChecked)}</time>
              </span>
            </span>
          )}
          {post.lang === "en" && <span class="rounded bg-muted px-2 py-0.5 text-xs">English</span>}
          {post.demo && <span class="rounded border border-border px-2 py-0.5 text-xs">ডেমো</span>}
        </div>
      </header>

      {post.thumbnail && (
        <figure class="mt-6">
          <img
            src={post.thumbnail}
            alt={post.thumbnailAlt || ""}
            width="1200"
            height="630"
            class="aspect-[16/9] w-full rounded-md object-cover"
          />
          {post.thumbnailAlt && (
            <figcaption class="mt-2 text-sm text-muted-foreground">{post.thumbnailAlt}</figcaption>
          )}
        </figure>
      )}

      {post.tracked && (
        <div class="tracker-box mt-6" role="note" aria-label="গল্প ট্র্যাকার">
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
            <span class="font-semibold">এই গল্পটি ট্র্যাক করা হচ্ছে</span>
            <a
              href="/tracked"
              class="font-medium text-primary underline underline-offset-2 hover:text-foreground"
            >
              ট্র্যাক করা সব গল্প →
            </a>
          </div>
          <p class="mt-1.5 leading-relaxed text-muted-foreground">
            একই ঘটনার খবর ভুলে যাইনি — নতুন অগ্রগতি পেলে এই প্রতিবেদনটিই হালনাগাদ হবে এবং এখানে পুরনো লেখা
            কখনো মুছে যাবে না।
          </p>
        </div>
      )}

      {post.factCheck && (() => {
        const verdict = getVerdict(post.factCheck);
        return (
          <div class="factcheck-box mt-6" role="note" aria-label="ফ্যাক্ট চেক">
            <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
              <span class="flex items-center gap-1.5 font-semibold">
                <Icon name="flag" class="h-4 w-4" />
                ফ্যাক্ট চেক
              </span>
              <a
                href="/factcheck"
                class="font-medium text-primary underline underline-offset-2 hover:text-foreground"
              >
                সব যাচাই →
              </a>
            </div>
            {post.factCheck.claim && (
              <p class="factcheck-claim mt-3 text-muted-foreground">{post.factCheck.claim}</p>
            )}
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
              {verdict && <span class:list={["verdict-chip", verdict.className]}>{verdict.label}</span>}
              {post.factCheck.verifiedDate && (
                <span class="text-xs text-muted-foreground">
                  যাচাই: <time datetime={post.factCheck.verifiedDate.toISOString()}>{formatDate(post.factCheck.verifiedDate)}</time>
                </span>
              )}
            </div>
            {post.factCheck.note && (
              <p class="mt-3 leading-relaxed text-muted-foreground">{post.factCheck.note}</p>
            )}
          </div>
        );
      })()}

      {post.corrected && post.correctionNote && (
        <div class="correction-box mt-6" role="note" aria-label="সংশোধন নোট">
          <div class="text-sm font-semibold">সংশোধন</div>
          <p class="mt-1.5 leading-relaxed text-muted-foreground">{post.correctionNote}</p>
        </div>
      )}

      {matchedEvents.length > 0 && (
        <aside class="event-flow-box mt-6" role="note" aria-label="ঘটনাপঞ্জি">
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
            <span class="font-semibold">এই ঘটনার আরও খবর (ঘটনাপঞ্জি)</span>
            <a
              href="/ghotona"
              class="font-medium text-primary underline underline-offset-2 hover:text-foreground"
            >
              ঘটনাপঞ্জির সব পাতা →
            </a>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            {matchedEvents.slice(0, 3).map((event) => (
              <a
                href={`/ghotona/${event.id}`}
                class="event-chip rounded-full border border-border px-3 py-1 text-xs hover:border-primary hover:text-primary"
              >
                {event.nameBn}
              </a>
            ))}
          </div>
        </aside>
      )}

      <div class="prose prose-lg prose-headings:font-serif prose-brown dark:prose-invert mt-8">
        {post.keyPoints?.length > 0 && (
          <div class="keypoints-box mb-6" role="note" aria-label="এক নজরে">
            <div class="text-sm font-bold">এক নজরে</div>
            <ul class="mt-3 space-y-2">
              {post.keyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        )}
        <div class="prose-article">
          <Content />
        </div>

        {post.faq?.length > 0 && (
          <div class="faq-box mt-10" role="note" aria-label="প্রশ্নোত্তর">
            <h2 class="font-serif text-2xl font-bold">প্রশ্নোত্তর</h2>
            <div class="mt-4 space-y-4">
              {post.faq.map((item) => (
                <div class="border-b border-border/60 pb-4">
                  <h3 class="font-semibold">{item.q}</h3>
                  <p class="mt-2 leading-relaxed text-muted-foreground">{item.a}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

        <div class="mt-8">
          {post.sources.length > 0 && (
          <div class="mt-4">
            <div class="text-sm font-bold">সূত্র</div>
            <div class="source-list mt-2">
              {post.sources.map((source) => (
                <a
                  href={source.url}
                  target="_blank"
                  rel="noreferrer"
                  class="underline-offset-2 hover:text-primary underline"
                >
                  {source.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      {post.updates && post.updates.length > 0 && (
        <div class="mt-3">
          <UpdateHistory updates={post.updates} formatTime={formatTime} formatDate={formatDate} />
        </div>
      )}

  {post.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground hover:border-primary hover:text-primary"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <div class="mt-6 border-t border-border/60 pt-4" role="group" aria-label="শেয়ার করুন">
        <div class="flex items-center gap-2 text-sm">
          <span class="flex items-center gap-1.5 font-medium">
            <Icon name="share" class="h-4 w-4" />
            শেয়ার:
          </span>
          {shareLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-border px-3 py-1 hover:border-primary hover:text-primary"
            >
              {link.name}
            </a>
          ))}
        </div>
      </div>
    </article>
  </div>

  {related.length > 0 && (
    <section class="mt-16 border-t border-border/60">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <h2 class="mb-6 font-serif text-2xl font-bold">আরও পড়ুন</h2>
        <div class="grid gap-8 sm:grid-cols-3">
          {related.map((item) => (
            <div class="mini-row">
              {item.thumbnail && (
                <a href={`/article/${item.slug}`} class="mini-row-thumb">
                  <img
                    src={item.thumbnail}
                    alt={item.thumbnailAlt || ""}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="mini-row-body">
                <a href={`/article/${item.slug}`}>{item.title}</a>
                <time class="mini-row-datetime" datetime={new Date(item.ts).toISOString()}>
                  {formatDateTimeBDShort(item.ts)}
                </time>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>