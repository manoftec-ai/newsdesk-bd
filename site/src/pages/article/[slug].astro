---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import VerificationBadge from "../../components/VerificationBadge.astro";
import UpdateHistory from "../../components/UpdateHistory.astro";
import Icon from "../../components/Icon.astro";
import Giscus from "../../components/Giscus.astro";

import {
  getCollection,
  render,
} from "astro:content";
import {
  SITE,
  getAuthor,
  getCategory,
  getBadge,
  getVerdict,
  formatDate,
  formatTime,
  formatDateTimeBD,
  formatDateTimeBDShort,
  relatedPosts,
} from "../../lib/news-data.js";
import { topicalEventsForPost } from "../../lib/events.js";
import { evidenceLabelBn, sourceNameBn } from "../../lib/evidence-label.js";

export async function getStaticPaths() {
  return (await getCollection("news", ({ data }) => !data.draft)).map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const post = {
  slug: entry.id,
  ...entry.data,
  date: formatDate(entry.data.date),
  ts: entry.data.date ? entry.data.date.getTime() : 0,
  year: entry.data.date.getFullYear(),
  updated: entry.data.updated ? formatDate(entry.data.updated) : undefined,
};

// Reading time was hardcoded to 1 whenever the story had no explicit value, so a
// 200-word article claimed "১ মিনিট পাঠ".
//
// Two earlier attempts silently returned nothing and were caught against the
// live page, not by a test: `entry.data.body` and `entry.body` do not exist in
// Astro 7, and reading the file relative to `import.meta.url` throws during the
// build because that URL is not the source path. Use Astro's own glob, which
// resolves at build time and is the idiomatic way to get raw content here.
const rawNews = import.meta.glob("../../content/news/*.md", {
  query: "?raw",
  import: "default",
});

const readingMinutes = (() => {
  const raw = rawNews[`../../content/news/${entry.id}.md`] ?? "";
  const bodyText = String(raw).replace(/^---\s*\n[\s\S]*?\n---\s*\n?/, "");
  const words = bodyText.split(/\s+/).filter(Boolean).length;
  // 150 wpm reads honestly for Bangla prose. At 200 the whole corpus rounded to
  // "1 মিনিট পাঠ" and the figure told a reader nothing.
  return Math.max(1, Math.round(words / 150));
})();

// A standfirst (উপশিরোনাম) is standard on every newspaper article and was
// missing on all 377. Use an explicit one when the story has it, otherwise the
// excerpt, but only when it says something the headline does not.
const standfirst = (() => {
  const explicit = String(entry.data.standfirst ?? entry.data.subhead ?? "").trim();
  if (explicit) return explicit;
  const ex = String(post.excerpt ?? "").trim();
  if (!ex) return "";
  const titleLength = String(post.title ?? "").length;
  const h = String(post.title ?? "").replace(/[।\s]+/g, "");
  const e = ex.replace(/[।\s]+/g, "");
  if (!e || e === h) return "";
  // 208 of the 377 excerpts are two fragments stitched together with a stray
  // "।।" seam (e.g. "...বাড়িয়েছে সরকার।। ডিজেল," — cut mid-list). Rather than
  // show no deck at all, keep the first complete sentence when there is one.
  if (/।\s*।/.test(ex)) {
    const firstSentence = ex.split(/।\s*।/)[0].trim().replace(/[,\s]+$/, "");
    const clean = firstSentence.includes("।") ? firstSentence : `${firstSentence}।`;
    return clean.length >= 40 ? clean : "";
  }
  // A deck must be a complete sentence. Reject a trailing ellipsis and a
  // fragment that stops mid-list.
  if (/[.…]{1,3}$/.test(ex)) return "";
  if (/[,\s]$/.test(ex)) return "";
  // A deck that runs most of the headline's length is a second headline, not a
  // summary.
  if (ex.length > Math.max(220, titleLength * 2.2)) return "";
  return ex;
})();

post.readingTime = entry.data.readingTime ?? readingMinutes;

// Byline. All 377 articles carried author: "desk" and no visible byline at all.
//
// These stories are aggregated from named outlets, not written by us, so
// attributing them to a reporter would be false and attributing them to the
// outlet bare would imply that outlet published the page here. The honest form
// is an explicit sourcing credit, which is also what Bangladeshi papers use when
// reprinting: "সূত্র: প্রথম আলো".
const byline = (() => {
  const names = [
    ...new Set(
      (post.sources ?? [])
        .map((s) => sourceNameBn(s.name) ?? s.name)
        .map((n) => String(n ?? "").trim())
        .filter(Boolean),
    ),
  ];
  if (!names.length) return null;
  if (names.length === 1) return `সূত্র: ${names[0]}`;
  if (names.length === 2) return `সূত্র: ${names[0]} ও ${names[1]}`;
  return `সূত্র: ${names[0]} ও অন্যান্য ${names.length - 1}টি মাধ্যম`;
})();

const category = getCategory(post.category);
const author = getAuthor(post.author);
const badge = getBadge(post);
const related = await relatedPosts(post);
const matchedEvents = topicalEventsForPost(post, 10);

const isoDate = (date) => (date ? new Date(date).toISOString() : undefined);
const pageTitle = post.seoTitle ?? `${post.title} — ${SITE.name}`;
const description = post.seoDescription ?? post.excerpt;

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsArticle",
      headline: post.title,
      description,
      articleSection: category?.name,
      datePublished: isoDate(entry.data.date),
      ...(entry.data.updated ? { dateModified: isoDate(entry.data.updated) } : {}),
      inLanguage: post.lang,
      keywords: (post.tags ?? []).join(", "),
      isAccessibleForFree: true,
      author: {
        "@type": "Person",
        name: author?.name ?? SITE.name,
        url: `${SITE.url}/authors/${author?.slug ?? "desk"}`,
      },
      publisher: {
        "@type": "NewsMediaOrganization",
        name: SITE.name,
        url: SITE.url,
        logo: { "@type": "ImageObject", url: `${SITE.url}/images/og-default.svg` },
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": `${SITE.url}/article/${post.slug}`,
      },
      ...(post.thumbnail ? { image: `${SITE.url}${post.thumbnail}` } : {}),
    },
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        {
          "@type": "ListItem",
          position: 1,
          name: "নীড়",
          item: `${SITE.url}/`,
        },
        ...(category
          ? [
              {
                "@type": "ListItem",
                position: 2,
                name: category.name,
                item: `${SITE.url}/category/${category.slug}`,
              },
            ]
          : []),
        {
          "@type": "ListItem",
          position: category ? 3 : 2,
          name: post.title,
          item: `${SITE.url}/article/${post.slug}`,
        },
      ],
    },
    ...(post.breaking
      ? [
          {
            "@type": "LiveBlogPosting",
            "@id": `${SITE.url}/article/${post.slug}#liveblog`,
            headline: post.title,
            description,
            coverageStartTime: isoDate(entry.data.date),
            datePublished: isoDate(entry.data.date),
            ...(entry.data.updated ? { dateModified: isoDate(entry.data.updated) } : {}),
            liveBlogUpdate: [
              {
                "@type": "BlogPosting",
                headline: post.title,
                datePublished: isoDate(entry.data.date),
                articleBody: post.excerpt,
              },
            ],
          },
        ]
      : []),
    ...(post.faq?.length
      ? [
          {
            "@type": "FAQPage",
            "@id": `${SITE.url}/article/${post.slug}#faq`,
            mainEntity: post.faq.map((item) => ({
              "@type": "Question",
              name: item.q,
              acceptedAnswer: { "@type": "Answer", text: item.a },
            })),
          },
        ]
      : []),
    ...(post.factCheck?.claim && post.factCheck?.verdict
      ? [
          {
            "@type": "ClaimReview",
            url: `${SITE.url}/article/${post.slug}`,
            claimReviewed: post.factCheck.claim,
            reviewRating: {
              "@type": "Rating",
              ratingValue:
                post.factCheck.verdict === "true"
                  ? 5
                  : post.factCheck.verdict === "mostly-true"
                    ? 4
                    : post.factCheck.verdict === "half"
                      ? 3
                      : post.factCheck.verdict === "mostly-false"
                        ? 2
                        : post.factCheck.verdict === "false"
                          ? 1
                          : post.factCheck.verdict === "misleading"
                            ? 2
                            : 3,
              alternateName: getVerdict(post.factCheck)?.label ?? post.factCheck.verdict,
              bestRating: 5,
              worstRating: 1,
            },
            author: { "@type": "Organization", name: SITE.name, url: SITE.url },
            itemReviewed: {
              "@type": "CreativeWork",
              author: { "@type": "Organization", name: SITE.name },
              datePublished: isoDate(entry.data.date),
            },
          },
        ]
      : []),
  ],
};

const shareUrl = `${SITE.url}/article/${post.slug}`;
const shareLinks = [
  {
    name: "X",
    href: `https://twitter.com/intent/tweet?url=${encodeURIComponent(shareUrl)}&text=${encodeURIComponent(post.title)}`,
  },
  {
    name: "ফেসবুক",
    href: `https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(shareUrl)}`,
  },
  {
    name: "হোয়াটসঅ্যাপ",
    href: `https://wa.me/?text=${encodeURIComponent(post.title)}%20${encodeURIComponent(shareUrl)}`,
  },
];
---

<BaseLayout
  title={pageTitle}
  description={description}
  canonical={`${SITE.url}/article/${post.slug}`}
  ogType="article"
  ogImage={post.thumbnail}
  jsonLd={jsonLd}
  language={post.lang === "en" ? "en" : "bn"}
>
  <div class="mx-auto max-w-4xl px-5">
    <Breadcrumbs
      crumbs={[
        ...(category ? [{ name: category.name, href: `/category/${category.slug}` }] : []),
        { name: "সংবাদ", href: `/article/${post.slug}`, current: true },
      ]}
    />
    <article class="mt-8">
      <header class="border-b border-border/60 pb-6">
        <div class="flex flex-wrap items-center gap-2">
          {category && (
            <a href={`/category/${category.slug}`} aria-label={category.name}>
              <span class="category-pill" style={`background-color:${category.color}`}>
                {category.name}
              </span>
            </a>
          )}
          <VerificationBadge badge={badge} tier={post.verification?.tier} />
          {post.corrected && (
            <span class="badge-chip badge--corrected" role="note" title="এই প্রতিবেদন সংশোধন করা হয়েছে">
              সংশোধিত
            </span>
          )}
          {post.tracked && (
            <a href="/tracked" class="tracked-chip" aria-label="ট্র্যাক করা গল্পের তালিকা">
              ট্র্যাক করা
            </a>
          )}
        </div>
        <p class="badge-legend">
          {badge.label}
          {post.verification?.tier ? ` [${post.verification.tier}]` : ""}
          {" — "}
          {badge.tierNote}
          {post.verification?.evidence?.length > 0 && ` · ${post.verification.evidence.length} প্রমাণ`}
          {post.verification?.score != null && ` · স্কোর ${post.verification.score}`}
        </p>

        {(post.verification?.evidence?.length ?? 0) > 0 && (
          <details class="evidence-panel mt-3" role="group" aria-label="প্রমাণ দেখুন">
            <summary class="evidence-summary">
              <span class="flex items-center gap-1.5">
                <Icon name="info" class="h-4 w-4" />
                প্রমাণ দেখুন
              </span>
              <span class="text-xs text-muted-foreground">
                — {post.verification.badge === "partial" ? "কেন একক/আংশিক" : "কেন নিশ্চিত বলছি"}
              </span>
            </summary>
            <div class="evidence-body mt-3">
              <p class="text-sm leading-relaxed text-muted-foreground">
                {post.verification.badge === "confirmed"
                  ? "দুই বা ততোধিক স্বাধীন সূত্রে তথ্যটি মিলেছে — বক্তব্যটি যাচাইকৃত।"
                  : post.verification.badge === "verified"
                    ? "অফিসিয়াল বা প্রাথমিক সূত্রে তথ্যটি নিশ্চিত হয়েছে।"
                    : "একক সূত্রের ভিত্তিতে বা আংশিক তথ্যে যাচাই — আরও সূত্র না মেশা পর্যন্ত সংক্ষিপ্ত থাকল।"}
              </p>
              {post.verification.tier && (
                <p class="mt-1 text-sm text-muted-foreground">
                  নির্ভরযোগ্যতার স্তর: <span class="font-medium">{post.verification.tier}</span>
                  {post.verification.score != null ? ` · স্কোর ${post.verification.score}` : ""}
                </p>
              )}
              <ul class="evidence-list mt-3 space-y-1.5">
                {(post.verification?.evidence ?? []).map((e) => (
                  <li class="flex items-baseline gap-2 text-sm">
                    <Icon name="check" class="h-3.5 w-3.5 shrink-0 text-primary" />
                    {e.url ? (
                      <a
                        href={e.url}
                        target="_blank"
                        rel="noreferrer"
                        class="underline-offset-2 hover:text-primary underline"
                      >
                        {evidenceLabelBn(e.label)}
                      </a>
                    ) : (
                      <span>{evidenceLabelBn(e.label)}</span>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          </details>
        )}

        <h1 class="mt-4 font-serif text-3xl font-bold leading-tight sm:text-4xl">
          {post.title}
        </h1>

        {standfirst && (
          <p class="standfirst mt-3 font-serif text-lg leading-relaxed text-muted-foreground">
            {standfirst}
          </p>
        )}

        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm text-muted-foreground">
          {byline && <span class="font-medium text-foreground">{byline}</span>}
          <span class="flex items-center gap-1.5">
            <Icon name="calendar" class="h-4 w-4" />
            <time datetime={entry.data.date.toISOString()}>{formatDateTimeBD(post.ts)}</time>
          </span>
          <span class="flex items-center gap-1.5">
            <Icon name="clock" class="h-4 w-4" />
            {post.readingTime} মিনিট পাঠ
          </span>
          {post.tracked && post.lastChecked && (
            <span class="flex items-center gap-1.5">
              <Icon name="eye" class="h-4 w-4" />
              <span>
                শেষ চেক:{" "}
                <time datetime={isoDate(post.lastChecked)}>{formatDate(post.lastChecked)}</time>
              </span>
            </span>
          )}
          {post.lang === "en" && <span class="rounded bg-muted px-2 py-0.5 text-xs">English</span>}
          {post.demo && <span class="rounded border border-border px-2 py-0.5 text-xs">ডেমো</span>}
        </div>
      </header>

      {post.thumbnail && (
        <figure class="mt-6">
          <img
            src={post.thumbnail}
            alt={post.thumbnailAlt || ""}
            width="1200"
            height="630"
            class="aspect-[16/9] w-full rounded-md object-cover"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          {post.thumbnailAlt && (
            <figcaption class="mt-2 text-sm text-muted-foreground">{post.thumbnailAlt}</figcaption>
          )}
        </figure>
      )}

      {post.updates && post.updates.length > 0 && (() => {
        const last = post.updates[post.updates.length - 1];
        return (
          <div class="what-changed mt-6" role="note" aria-label="কী বদলেছে">
            <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
              <span class="flex items-center gap-1.5 font-semibold">
                <Icon name="refresh" class="h-4 w-4" />
                কী বদলেছে
              </span>
              <a
                href="#update-history"
                class="font-medium text-primary underline underline-offset-2 hover:text-foreground"
              >
                পুরো আপডেট ইতিহাস →
              </a>
            </div>
            <p class="mt-1.5 leading-relaxed text-muted-foreground">
              <time datetime={new Date(last.date).toISOString()}>
                {formatDateTimeBDShort(new Date(last.date).getTime())}
              </time>
              {" — "}
              {last.note}
            </p>
          </div>
        );
      })()}

      {post.tracked && (
        <div class="tracker-box mt-6" role="note" aria-label="গল্প ট্র্যাকার">
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
            <span class="font-semibold">এই গল্পটি ট্র্যাক করা হচ্ছে</span>
            <a
              href="/tracked"
              class="font-medium text-primary underline underline-offset-2 hover:text-foreground"
            >
              ট্র্যাক করা সব গল্প →
            </a>
          </div>
          <p class="mt-1.5 leading-relaxed text-muted-foreground">
            একই ঘটনার খবর ভুলে যাইনি — নতুন অগ্রগতি পেলে এই প্রতিবেদনটিই হালনাগাদ হবে এবং এখানে পুরনো লেখা
            কখনো মুছে যাবে না।
          </p>
        </div>
      )}

      {post.factCheck && (() => {
        const verdict = getVerdict(post.factCheck);
        return (
          <div class="factcheck-box mt-6" role="note" aria-label="ফ্যাক্ট চেক">
            <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
              <span class="flex items-center gap-1.5 font-semibold">
                <Icon name="flag" class="h-4 w-4" />
                ফ্যাক্ট চেক
              </span>
              <a
                href="/factcheck"
                class="font-medium text-primary underline underline-offset-2 hover:text-foreground"
              >
                সব যাচাই →
              </a>
            </div>
            {post.factCheck.claim && (
              <p class="factcheck-claim mt-3 text-muted-foreground">{post.factCheck.claim}</p>
            )}
            <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
              {verdict && <span class:list={["verdict-chip", verdict.className]}>{verdict.label}</span>}
              {post.factCheck.verifiedDate && (
                <span class="text-xs text-muted-foreground">
                  যাচাই: <time datetime={post.factCheck.verifiedDate.toISOString()}>{formatDate(post.factCheck.verifiedDate)}</time>
                </span>
              )}
            </div>
            {post.factCheck.note && (
              <p class="mt-3 leading-relaxed text-muted-foreground">{post.factCheck.note}</p>
            )}
          </div>
        );
      })()}

      {post.corrected && post.correctionNote && (
        <div class="correction-box mt-6" role="note" aria-label="সংশোধন নোট">
          <div class="text-sm font-semibold">সংশোধন</div>
          <p class="mt-1.5 leading-relaxed text-muted-foreground">{post.correctionNote}</p>
        </div>
      )}

      {matchedEvents.length > 0 && (
        <aside class="event-flow-box mt-6" role="note" aria-label="ঘটনাপঞ্জি">
          <div class="flex flex-wrap items-center justify-between gap-2 text-sm">
            <span class="font-semibold">এই ঘটনার আরও খবর</span>
            <a
              href="/ghotona"
              class="font-medium text-primary underline underline-offset-2 hover:text-foreground"
            >
              সব ঘটনার পাতা →
            </a>
          </div>
          <div class="mt-3 flex flex-wrap gap-2">
            {matchedEvents.slice(0, 3).map((event) => (
              <a
                href={`/ghotona/${event.id}`}
                class="event-chip rounded-full border border-border px-3 py-1 text-xs hover:border-primary hover:text-primary"
              >
                {event.nameBn}
              </a>
            ))}
          </div>
        </aside>
      )}

      <div class="prose prose-lg prose-headings:font-serif prose-brown dark:prose-invert mt-8">
        {post.keyPoints?.length > 0 && (
          <div class="keypoints-box mb-6" role="note" aria-label="এক নজরে">
            <div class="text-sm font-bold">এক নজরে</div>
            <ul class="mt-3 space-y-2">
              {post.keyPoints.map((point) => (
                <li>{point}</li>
              ))}
            </ul>
          </div>
        )}
        <div class="prose-article">
          <Content />
        </div>

        {post.faq?.length > 0 && (
          <div class="faq-box mt-10" role="note" aria-label="প্রশ্নোত্তর">
            <h2 class="font-serif text-2xl font-bold">প্রশ্নোত্তর</h2>
            <div class="mt-4 space-y-4">
              {post.faq.map((item) => (
                <div class="border-b border-border/60 pb-4">
                  <h3 class="font-semibold">{item.q}</h3>
                  <p class="mt-2 leading-relaxed text-muted-foreground">{item.a}</p>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

        <div class="mt-8">
          {post.sources.length > 0 && (
          <div class="mt-4">
            <div class="text-sm font-bold">সূত্র</div>
            <div class="source-list mt-2">
              {post.sources.map((source) => (
                <a
                  href={source.url}
                  target="_blank"
                  rel="noreferrer"
                  class="underline-offset-2 hover:text-primary underline"
                >
                  {sourceNameBn(source.name) ?? source.name}
                </a>
              ))}
            </div>
          </div>
        )}
      </div>

      {post.updates && post.updates.length > 0 && (
        <div class="mt-3" id="update-history">
          <UpdateHistory updates={post.updates} formatTime={formatTime} formatDate={formatDate} />
        </div>
      )}

  {post.tags.length > 0 && (
        <div class="mt-6 flex flex-wrap gap-2">
          {post.tags.map((tag) => (
            <a
              href={`/tags/${tag}`}
              class="rounded-full border border-border px-3 py-1 text-xs text-muted-foreground hover:border-primary hover:text-primary"
            >
              #{tag}
            </a>
          ))}
        </div>
      )}

      <div class="mt-6 border-t border-border/60 pt-4" role="group" aria-label="শেয়ার করুন">
        <div class="flex items-center gap-2 text-sm">
          <span class="flex items-center gap-1.5 font-medium">
            <Icon name="share" class="h-4 w-4" />
            শেয়ার:
          </span>
          {shareLinks.map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noreferrer"
              class="rounded-md border border-border px-3 py-1 hover:border-primary hover:text-primary"
            >
              {link.name}
            </a>
          ))}
        </div>
      </div>

      <Giscus slug={post.slug} title={post.title} />
    </article>
  </div>

  {related.length > 0 && (
    <section class="mt-16 border-t border-border/60">
      <div class="mx-auto max-w-6xl px-5 py-10">
        <h2 class="mb-6 font-serif text-2xl font-bold">আরও পড়ুন</h2>
        <div class="grid gap-8 sm:grid-cols-3">
          {related.map((item) => (
            <div class="mini-row">
              {item.thumbnail && (
                <a href={`/article/${item.slug}`} class="mini-row-thumb">
                  <img
                    src={item.thumbnail}
                    alt={item.thumbnailAlt || ""}
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="mini-row-body">
                <a href={`/article/${item.slug}`}>{item.title}</a>
                <time class="mini-row-datetime" datetime={new Date(item.ts).toISOString()}>
                  {formatDateTimeBDShort(item.ts)}
                </time>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}
</BaseLayout>