---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../lib/news-data.js";
---

<BaseLayout
  title={`ব্যবহারের শর্তাবলী — ${SITE.name}`}
  description={`${SITE.name} ব্যবহারের শর্তাবলী — কনটেন্টের প্রকৃতি, মেধাস্বত্ব, অনুমোদিত ব্যবহার ও দায় সীমা।`}
  canonical={`${SITE.url}/terms`}
>
  <div class="mx-auto max-w-3xl px-5">
    <Breadcrumbs crumbs={[{ name: "ব্যবহারের শর্তাবলী", href: "/terms", current: true }]} />
    <header class="mt-6 border-b border-border/60 pb-4">
      <h1 class="font-serif text-4xl font-bold">ব্যবহারের শর্তাবলী</h1>
      <p class="mt-2 text-muted-foreground">
        {SITE.name} ({SITE.url}) ব্যবহার করলে নিচের শর্তগুলোতে আপনি সম্মত হচ্ছেন বলে ধরা হবে।
      </p>
    </header>

    <div class="prose prose-lg prose-brown dark:prose-invert mt-8">
      <h2>কনটেন্টের প্রকৃতি</h2>
      <p>
        এখানে প্রকাশিত প্রতিবেদনগুলো একাধিক প্রকাশিত সংবাদ ও দাপ্তরিক সূত্র যাচাই করে তৈরি করা
        মূল/সংক্ষিপ্ত (synthesized) প্রতিবেদন। প্রতিটি সংবাদের সাথে <em>উৎস</em> ও <em>প্রমাণ</em>
        দেখানো হয়। মূল সংবাদ মাধ্যমগুলোর প্রতিবেদনই প্রকৃত উৎস — প্রয়োজনে সেগুলো চেক করার অনুরোধ
        করা হয়।
      </p>

      <h2>মেধাস্বত্ব</h2>
      <ul>
        <li>
          {SITE.name}-এর নিজস্ব লেখা, সংশ্লেষণ ও নকশার স্বত্ব আমাদের — হুবহু পুনঃপ্রকাশে আমাদের
          অনুমতি লাগবে।
        </li>
        <li>
          উৎস হিসেবে ব্যবহৃত সংবাদমাধ্যমগুলোর নিজস্ব কনটেন্ট তাদের স্বত্বাধিকারীর মালিকানায় থেকে যায়;
          আমরা শুধু তাদের ডেটা উদ্ধৃত ও লিংক করি।
        </li>
        <li>
          যুক্তিসঙ্গত পরিমাণে উদ্ধৃতি (কোটা) বা লিংক করাতে কোনো বাধা নেই — অবশ্য সূত্র উল্লেখ করা
          আপনার দায়িত্ব।
        </li>
      </ul>

      <h2>অনুমোদিত ব্যবহার</h2>
      <p>
        সাইটটি ব্যক্তিগত পড়া, শিক্ষা, প্রতিবেদন ও গবেষণার জন্য। নিচের কাজগুলো নিষিদ্ধ:
      </p>
      <ul>
        <li>বানিজ্যিকভাবে আমাদের কনটেন্ট হুবহু পুনঃবিক্রয় বা পুনঃপ্রকাশ</li>
        <li>কারিগরিভাবে সাইট স্ক্র্যাপ/ওভারলোড করে সেবা ব্যাহত করা</li>
        <li>সাইটের তথ্য পরিবর্তন করে মিথ্যা ছড়ানো</li>
      </ul>

      <h2>তথ্যের নির্ভুলতা ও হালনাগাদ</h2>
      <p>
        সংবাদগত কারণে দ্রুত পরিবর্তন হয়। আমরা চেষ্টা করি সঠিক ও হালনাগাদ তথ্য দিতে, কিন্তু কিছু
        প্রতিবেদন প্রকাশের পরে আরও যাচাইয়ের অপেক্ষায় থাকতে পারে। ভুল ধরা পড়লে আমাদের{' '}
        <a href="/corrections">সংশোধন নীতি</a> অনুযায়ী তা স্বচ্ছভাবে সংশোধিত হয়।
      </p>

      <h2>বাহ্যিক উৎস</h2>
      <p>
        আমরা উৎস সংবাদমাধ্যমের সাইটের জন্য দায়ী নই। সেগুলোর নিয়ম ও নীতির ভিত্তিতে সেগুলো ব্যবহার
        হবে।
      </p>

      <h2>দায় সীমা</h2>
      <p>
        এই সাইটের তথ্য আর্থিক, আইনি, চিকিৎসা বা বিনিয়োগ-সংক্রান্ত পরামর্শ নয়। তথ্যের ওপর নির্ভর
        করে নেওয়া সিদ্ধান্তের দায় ব্যবহারকারীর নিজের। সর্বাধিক পরিমাণে, আমাদের দায় সীমিত রাখা
        হয় নির্দিষ্ট কোনো ঘটনার পরিণতি নয়, বরং সরাসরি ক্ষতির মধ্যে।
      </p>

      <h2>প্রযোজ্য আইন</h2>
      <p>এই শর্তাবলী বাংলাদেশের আইনের অধীনে পরিচালিত হবে এবং বাংলাদেশের আদালতে বিরোধ নিষ্পত্তি হবে।</p>

      <h2>শর্তাবলীর পরিবর্তন</h2>
      <p>
        প্রয়োজনে আমরা এই শর্তাবলী হালনাগাদ করতে পারি; সর্বশেষ সংস্করণ এই পাতায় প্রকাশিত থাকবে।
      </p>

      <div class="mt-6 rounded-md border border-border/60 p-4 text-sm">
        <strong>প্রকাশক:</strong> যাচাইডেস্ক — ঢাকা-১২০৫, বাংলাদেশ · <a href="mailto:hello@jachaidesk.com" class="underline">hello@jachaidesk.com</a> · NewsMediaOrganization
      </div>

      <p class="mt-4 text-sm text-muted-foreground">সর্বশেষ হালনাগাদ: ২৩ সেপ্টেম্বর ২০২৬</p>
    </div>
  </div>
</BaseLayout>