---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { categories, tags, SITE } from "../lib/news-data.js";

const title = `খুঁজুন — ${SITE.name}`;
---

<BaseLayout title={title} description="যাচাইডেস্কে খুঁজুন।" robots="noindex, follow">
  {/* noindex: search-result pages are thin/duplicate by nature and must not
      compete in the index (SEO audit 2026-09-27). follow keeps discovery. */}
  <div class="mx-auto max-w-4xl px-5">
    <Breadcrumbs crumbs={[{ name: "খুঁজুন", href: "/search", current: true }]} />

    <header class="mt-6 border-b border-border/60 pb-4">
      <h1 class="font-serif text-4xl font-bold">খুঁজুন</h1>
      <p class="mt-2 text-muted-foreground">সব সংবাদ ও ট্যাগ অনুসন্ধান করুন।</p>
    </header>

    <div class="mt-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-center">
        <input
          id="q"
          type="search"
          placeholder="শিরোনাম, ট্যাগ বা ঘটনা লিখুন…"
          class="w-full rounded-md border border-border bg-background px-3 py-2 text-sm outline-none focus:border-primary"
          aria-label="অনুসন্ধান"
        />
        <select
          id="cat"
          class="rounded-md border border-border bg-background px-3 py-2 text-sm"
          aria-label="বিভাগ"
        >
          <option value="">সব বিভাগ</option>
          {categories.map((c) => (
            <option value={c.name}>{c.name}</option>
          ))}
        </select>
      </div>
      <div id="results" class="mt-6 min-h-14 text-sm text-muted-foreground">
        খোঁজার বাক্স লোড হচ্ছে…
      </div>
    </div>

    <div class="mt-10 grid gap-10 sm:grid-cols-2">
      <section>
        <h2 class="mb-3 font-serif text-xl font-bold">বিভাগসমূহ</h2>
        <div class="flex flex-wrap gap-2">
          {categories.map((category) => (
            <a
              href={`/category/${category.slug}`}
              class="category-pill"
              style={`background-color:${category.color}`}
            >
              {category.name}
            </a>
          ))}
        </div>
      </section>
      <section>
        <h2 class="mb-3 font-serif text-xl font-bold">জনপ্রিয় ট্যাগ</h2>
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <a
              href={`/tags/${tag.slug}`}
              class="rounded-full border border-border px-3 py-1 text-sm text-muted-foreground hover:border-primary hover:text-primary"
            >
              #{tag.name}
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const qInput = document.getElementById("q");
  const catSelect = document.getElementById("cat");
  const resultsEl = document.getElementById("results");
  let pagefind = null;

  const escapeHtml = (s) =>
    String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);

  const render = async (query, category) => {
    if (!pagefind || !query.trim()) {
      resultsEl.innerHTML = pagefind ? "একটি শব্দ লিখে খুঁজুন…" : resultsEl.innerHTML;
      return;
    }
    const filters = category ? { category } : undefined;
    const search = await pagefind.search(query, filters ? { filters } : undefined);
    const items = await Promise.all(search.results.slice(0, 20).map((r) => r.data()));
    if (!items.length) {
      resultsEl.innerHTML = '<p class="text-muted-foreground">কিছু পাওয়া যায়নি।</p>';
      return;
    }
    resultsEl.innerHTML = `<p class="mb-3 text-xs text-muted-foreground">${search.results.length}টি ফল</p>` +
      items
        .map(
          (d) => `
        <a href="${escapeHtml(d.url)}" class="mb-4 block border-b border-border/60 pb-3">
          <span class="font-medium text-foreground hover:text-primary">${escapeHtml(d.meta?.title ?? d.url)}</span>
          <span class="mt-1 block text-xs text-muted-foreground">${d.excerpt ?? ""}</span>
        </a>`,
        )
        .join("");
  };

  const init = async () => {
    try {
      pagefind = await import("/pagefind/pagefind.js");
      resultsEl.innerHTML = '<p class="text-muted-foreground">একটি শব্দ লিখে খুঁজুন…</p>';
      qInput.addEventListener("input", () => render(qInput.value, catSelect.value));
      catSelect.addEventListener("change", () => render(qInput.value, catSelect.value));
    } catch {
      resultsEl.innerHTML = "সরাসরি অনুসন্ধান এই সংস্করণে নেই — উপরের বিভাগ/ট্যাগ ব্যবহার করুন।";
    }
  };

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", init, { once: true });
  } else {
    init();
  }
</script>