---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { SITE, sortedPosts } from "../../lib/news-data.js";
---

<BaseLayout
  title={`সব খবর — ${SITE.name}`}
  description="নিউজডেস্ক বিডির সব যাচাই-করা সংবাদ, ক্রম অনুযায়ী।"
>
  <div class="mx-auto max-w-6xl px-5">
    <Breadcrumbs crumbs={[{ name: "সব খবর", href: "/news" }]} />
    <header class="mt-6 mb-8 border-b border-border/60 pb-4">
      <h1 class="font-serif text-4xl font-bold">সব খবর</h1>
      <p class="mt-2 text-muted-foreground">যাচাই-করা সংবাদ, সূত্রসহ।</p>
    </header>

    {(await sortedPosts()).map((post) => (
      <PostCard post={post} variant="list" />
    ))}
  </div>
</BaseLayout>