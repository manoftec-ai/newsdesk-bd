---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import BreakingBar from "../components/BreakingBar.astro";
import VerificationBadge from "../components/VerificationBadge.astro";

import {
  SITE,
  categories,
  breakingItems,
  featuredPost,
  sortedPosts,
  postsByCategory,
  getCategory,
  getBadge,
} from "../lib/news-data.js";

const now = new Date();
const breaking = await breakingItems();
const lead = await featuredPost();
const all = await sortedPosts();
const rest = all.filter((p) => p.slug !== lead?.slug);
const secondLine = rest.slice(0, 4);

const leadBadge = lead ? getBadge(lead) : null;
const leadCategory = lead ? getCategory(lead.category) : null;

const homeSections = await Promise.all(
  categories
    .filter((category) => category.slug !== "latest")
    .slice(0, 4)
    .map(async (category) => ({
      category,
      posts: (await postsByCategory(category.slug)).slice(0, 3),
    })),
);

const dateTime = new Intl.DateTimeFormat("bn-BD", {
  hour: "numeric",
  minute: "2-digit",
}).format(now);
---

<BaseLayout
  description={`${SITE.description} সর্বশেষ আপডেট: ${dateTime}, ${now.toLocaleDateString("bn-BD")}`}
>
  <!-- Masthead (brand block, homepage only) -->
  <section class="masthead">
    <h1 class="masthead-name">
      <a href="/">
        নিউজডেস্ক <span class="accent">বিডি</span><span class="accent">.</span>
      </a>
    </h1>
    <p class="masthead-tagline">{SITE.tagline}</p>
  </section>

  {breaking.length > 0 && <BreakingBar items={breaking} />}

  <div class="mx-auto max-w-6xl px-5">
    <!-- Lead story -->
    {
      lead && (
        <section class="mt-8" aria-label="আজকের প্রধান খবর">
          <a href={`/article/${lead.slug}`} class="lead-article block">
            {lead.thumbnail && (
              <div class="aspect-[16/9] overflow-hidden bg-muted md:aspect-[21/9]">
                <img
                  src={lead.thumbnail}
                  alt={lead.thumbnailAlt || ""}
                  width="1200"
                  height="630"
                  fetchpriority="high"
                  decoding="async"
                  class="h-full w-full object-cover"
                />
              </div>
            )}
            <div class="lead-article-content">
              <div class="flex flex-wrap items-center gap-2 text-xs">
                {leadCategory && (
                  <span class="category-pill" style={`background-color:${leadCategory.color}`}>
                    {leadCategory.name}
                  </span>
                )}
                <VerificationBadge badge={leadBadge} />
                <time datetime={lead.date} class="text-muted-foreground">
                  {lead.date}
                </time>
              </div>
              <h2>{lead.title}</h2>
              <p class="mt-3 max-w-3xl text-muted-foreground">{lead.excerpt}</p>
              <div class="mt-4 text-sm font-medium text-primary">
                {lead.readingTime} মিনিট পাঠ →
              </div>
            </div>
          </a>
        </section>
      )
    }

    <!-- Secondary line: 2x2 mini rows -->
    {
      secondLine.length > 0 && (
        <section class="mt-8" aria-label="আরও খবর">
          <div class="grid gap-x-8 gap-y-4 md:grid-cols-2">
            {secondLine.map((post) => (
              <div class="mini-row">
                <time class="mini-row-time" datetime={post.date}>
                  {post.date}
                </time>
                <div>
                  <a href={`/article/${post.slug}`}>{post.title}</a>
                </div>
              </div>
            ))}
          </div>
        </section>
      )
    }

    <!-- Category sections with cards -->
    {homeSections
      .filter((section) => section.posts.length > 0)
      .map((section) => (
        <section class="mt-12" aria-labelledby={`cat-${section.category.slug}`}>
          <div class="mb-4 flex items-center justify-between border-b border-border/60 pb-2">
            <a
              id={`cat-${section.category.slug}`}
              href={`/category/${section.category.slug}`}
              class="font-serif text-2xl font-bold"
            >
              <span
                class="category-pill"
                style={`background-color:${section.category.color}`}
              >
                {section.category.name}
              </span>
            </a>
            <a
              href={`/category/${section.category.slug}`}
              class="text-sm text-muted-foreground hover:text-primary"
            >
              সব দেখুন →
            </a>
          </div>
          <div class="grid gap-8 sm:grid-cols-3">
            {section.posts.map((post) => (
              <PostCard post={post} />
            ))}
          </div>
        </section>
      ))}
  </div>
</BaseLayout>