---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import HeroSlider from "../components/HeroSlider.astro";
import BreakingBar from "../components/BreakingBar.astro";
import VerificationBadge from "../components/VerificationBadge.astro";

import {
  SITE,
  CONTACT,
  categories,
  editorialOrder,
  postsByCategory,
  getBadge,
  getAuthor,
  formatDateTimeBDShort,
} from "../lib/news-data.js";

const now = new Date();
const all = await editorialOrder();
// 2026-10-01: the hero is a slider of the 5 latest stories, so the top of the
// page always carries several fresh headlines instead of one.
const heroSlides = all.slice(0, 5);
const heroSlugs = new Set(heroSlides.map((p) => p.slug));
const rest = all.filter((p) => !heroSlugs.has(p.slug));
const secondLine = rest.slice(0, 4);
const tickerItems = rest.slice(4, 7);

const shownSlugs = new Set([
  ...heroSlugs,
  ...secondLine.map((p) => p.slug),
]);

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "NewsMediaOrganization",
      "@id": `${SITE.url}/#organization`,
      name: SITE.name,
      url: SITE.url,
      logo: `${SITE.url}/favicon.svg`,
      sameAs: [CONTACT.socialUrl].filter(Boolean),
      description: SITE.description,
    },
    {
      "@type": "WebSite",
      "@id": `${SITE.url}/#website`,
      url: SITE.url,
      name: SITE.name,
      description: SITE.description,
      inLanguage: "bn-BD",
      publisher: { "@id": `${SITE.url}/#organization` },
    },
    {
      "@type": "WebPage",
      "@id": `${SITE.url}/#homepage`,
      url: SITE.url,
      name: SITE.name,
      isPartOf: { "@id": `${SITE.url}/#website` },
    },
  ],
};

const homeSections = await Promise.all(
  categories
    .filter((category) => category.slug !== "latest")
    .slice(0, 4)
    .map(async (category) => {
      const posts = (await postsByCategory(category.slug))
        .filter((p) => !shownSlugs.has(p.slug))
        .slice(0, 2);
      return { category, posts };
    }),
);

// 2026-10-02 homepage editorial hierarchy: after the chronological feed show
// the two signature non-chronological lanes before the category buckets.
const trackedStories = all
  .filter((p) => p.tracked && !heroSlugs.has(p.slug))
  .slice(0, 3);
const factcheckStories = all
  .filter((p) => (p.category === "factcheck" || p.factCheck) && !heroSlugs.has(p.slug))
  .slice(0, 3);

const dateTime = new Intl.DateTimeFormat("bn-BD", {
  hour: "numeric",
  minute: "2-digit",
}).format(now);
---

<BaseLayout
  description={`${SITE.description} সর্বশেষ আপডেট: ${dateTime}, ${now.toLocaleDateString("bn-BD")}`}
  jsonLd={jsonLd}
>
  <!-- Masthead (brand block, homepage only) -->
  <section class="masthead">
    <h1 class="masthead-name">
      <a href="/">
        যাচাইডেস্ক<span class="accent">.</span>
      </a>
    </h1>
    <p class="masthead-tagline">{SITE.tagline}</p>
  </section>

  {tickerItems.length > 0 && <BreakingBar items={tickerItems} />}

  <div class="mx-auto max-w-6xl px-5">
    <!-- Hero slider: the 5 latest stories, swipeable, no autoplay -->
    <HeroSlider slides={heroSlides} />

    <!-- Latest headlines: a titled strip under the hero, each row with its
         thumbnail on the LEFT (2026-10-01, user request). The .mini-row grid is
         `auto 1fr`, so the thumb simply becomes the first child again — the
         CSS was always written for it, the markup had drifted to one column. -->
    {
      secondLine.length > 0 && (
        <section class="mt-8" aria-labelledby="latest-headlines">
          <h2 id="latest-headlines" class="mb-2 border-b border-border/60 pb-2 font-serif text-2xl font-bold">
            সাম্প্রতিক খবর
          </h2>
          <div class="grid gap-x-8 md:grid-cols-2">
            {secondLine.map((post) => {
              const author = getAuthor(post.author);
              const badge = getBadge(post);
              return (
                <div class="mini-row">
                  {post.thumbnail && (
                    /* Not a link: the headline beside it is the link, and two
                       links to the same article (one hidden from assistive
                       tech) would be a duplicate control for screen readers. */
                    <span class="mini-row-thumb">
                      <img
                        src={post.thumbnail}
                        alt=""
                        width="176"
                        height="102"
                        loading="lazy"
                        decoding="async"
                      />
                    </span>
                  )}
                  <div class="mini-row-body">
                    <div class="flex items-center gap-2 text-xs">
                      <VerificationBadge badge={badge} compact />
                    </div>
                    <a href={`/article/${post.slug}`} class="mt-1 block font-medium leading-snug hover:text-primary">
                      {post.title}
                    </a>
                    <div class="mini-row-meta flex flex-wrap items-center gap-3 mt-1 text-xs text-muted-foreground">
                      <time datetime={new Date(post.ts).toISOString()}>
                        {formatDateTimeBDShort(post.ts)}
                      </time>
                      {author && <span class="flex items-center gap-1">✍️ {author.shortName || author.name}</span>}
                    </div>
                  </div>
                </div>
              );
            })}
          </div>
        </section>
      )
    }

    {trackedStories.length > 0 && (
      <section class="mt-12" aria-labelledby="tracked-headlines">
        <h2 id="tracked-headlines" class="mb-2 border-b border-border/60 pb-2 font-serif text-2xl font-bold">
          ট্র্যাক করা গুরুত্বপূর্ণ ঘটনা
        </h2>
        <div class="grid gap-2">
          {trackedStories.map((post) => (
            <a href={`/article/${post.slug}`} class="font-medium leading-snug hover:text-primary">
              {post.title}
            </a>
          ))}
        </div>
        <a href="/tracked" class="mt-2 inline-block text-sm text-muted-foreground hover:text-primary">সব দেখুন →</a>
      </section>
    )}

    {factcheckStories.length > 0 && (
      <section class="mt-12" aria-labelledby="factcheck-headlines">
        <h2 id="factcheck-headlines" class="mb-2 border-b border-border/60 pb-2 font-serif text-2xl font-bold">
          ফ্যাক্ট চেক
        </h2>
        <div class="grid gap-2">
          {factcheckStories.map((post) => (
            <a href={`/article/${post.slug}`} class="font-medium leading-snug hover:text-primary">
              {post.title}
            </a>
          ))}
        </div>
        <a href="/factcheck" class="mt-2 inline-block text-sm text-muted-foreground hover:text-primary">সব দেখুন →</a>
      </section>
    )}

    <!-- Category sections with cards -->
    {homeSections
      .filter((section) => section.posts.length > 0)
      .map((section, index) => (
        <>
          {index > 0 && <hr class="home-section-divider" />}
          <section class="mt-12" aria-labelledby={`cat-${section.category.slug}`}>
            <div class="mb-4 flex items-center justify-between border-b border-border/60 pb-2">
              <a
                id={`cat-${section.category.slug}`}
                href={`/category/${section.category.slug}`}
                class="font-serif text-2xl font-bold"
              >
                <span
                  class="category-pill"
                  style={`background-color:${section.category.color}`}
                >
                  {section.category.name}
                </span>
              </a>
              <a
                href={`/category/${section.category.slug}`}
                class="text-sm text-muted-foreground hover:text-primary"
              >
                সব দেখুন →
              </a>
            </div>
            <div class="grid gap-8 sm:grid-cols-2">
              {section.posts.map((post) => (
                <PostCard post={post} />
              ))}
            </div>
          </section>
        </>
      ))}
  </div>
</BaseLayout>